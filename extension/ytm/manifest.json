{
  "manifest_version": 3,
  "name": "FubuNotch v2 · YouTube",
  "version": "0.2.2",
  "description": "Lets FubuNotch v2's island change YouTube Music's shuffle and repeat, and watch a YouTube video in a small window under the island. Talks only to FubuNotch on this PC (127.0.0.1).",
  "host_permissions": ["http://127.0.0.1:47821/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["https://music.youtube.com/*"], "js": ["page.js"], "world": "MAIN", "run_at": "document_idle" },
    { "matches": ["https://www.youtube.com/*"], "js": ["watch.js"], "world": "MAIN", "run_at": "document_idle" },
    { "matches": ["https://music.youtube.com/*", "https://www.youtube.com/*"], "js": ["relay.js"], "run_at": "document_idle" }
  ]
}
