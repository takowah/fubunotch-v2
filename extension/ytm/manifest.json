{
  "manifest_version": 3,
  "name": "FubuNotch v2 · YouTube Music",
  "version": "0.1.0",
  "description": "Lets FubuNotch v2's island show and change YouTube Music's shuffle and repeat. Talks only to FubuNotch on this PC (127.0.0.1).",
  "host_permissions": ["http://127.0.0.1:47821/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["https://music.youtube.com/*"], "js": ["page.js"], "world": "MAIN", "run_at": "document_idle" },
    { "matches": ["https://music.youtube.com/*"], "js": ["relay.js"], "run_at": "document_idle" }
  ]
}
