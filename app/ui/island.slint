// The island, drawn after Mini Island for Windows (its look and sizes, read
// from its own code and from pictures of it on the owner's screen): a near
// solid dark body whose left side takes the colour of what it shows (the
// app's, the song's), one shape that morphs between a hidden handle, a
// capsule (a notification, the song, the line being sung) and an open list
// with tabs (Notifications, Music, Lyrics, Accounts). Its size and radius
// spring between modes; pages fade. The window itself never changes size:
// Rust clips it to the island with a window region.
//
// The capsule is drawn at Mini Island's "Extra large" size (Mini.k = 1.5);
// the notification card and the open list at its normal size.

// Allo (Josh Puckett, SIL OFL 1.1, assets/fonts/OFL-Allo.txt), built into
// the app: the island's and Settings' text. Icons stay Segoe Fluent Icons.
import "../assets/fonts/Allo-Regular.otf";
import "../assets/fonts/Allo-Medium.otf";
import "../assets/fonts/Allo-SemiBold.otf";
import "../assets/fonts/Allo-Bold.otf";
import "../assets/fonts/Allo-ExtraBold.otf";
import { Ice } from "theme.slint";
export { Ice }

export struct ActionInfo {
    id: string,
    label: string,
}

export struct Item {
    actions: [ActionInfo],
    source: string,
    // A system notice's icon (SysIcon), else "".
    icon: string,
    title: string,
    body: string,
    kind: string,
    progress: float,
    has-progress: bool,
    accent: color,
    // The first letter of the app, for its round icon.
    initial: string,
    // The app's real logo (rounded by Rust), when Windows has one.
    logo: image,
    has-logo: bool,
}

export struct TabInfo {
    id: string,
    label: string,
}

// One account NotchDeck manages (Accounts tab).
// One limit window under an account (Accounts tab): "5-hour", 0.32, "32% used", "resets 22:00".
export struct UsageRow {
    label: string,
    used: float,
    used-text: string,
    resets: string,
}

export struct AccountRow {
    id: string,
    name: string,
    initial: string,
    active: bool,
    // Its plan ("Max 20x"), its limits and a note ("Updated 18 min ago", one line per row).
    plan: string,
    windows: [UsageRow],
    note: string,
    note-lines: int,
}

// One app's accounts on the Accounts tab: a title and a line of chips. A
// line with no title carries on the one above (its chips didn't fit).
export struct AccountGroup {
    title: string,
    accounts: [AccountRow],
}

export struct RoundRow {
    time: string,
    length: string,
    full: bool,
}

export struct FocusView {
    phase: string,
    left: string,
    rounds: string,
    running: bool,
    fraction: float,
    on-break: bool,
    // "3 rounds · 1 h 15 m".
    today: string,
    // Today's latest rounds, newest first.
    log: [RoundRow],
}

export struct HourBar {
    label: string,
    fraction: float,
    now: bool,
}

export struct WaterView {
    // Ml drunk today, a bare number.
    total: string,
    goal: string,
    glass: string,
    percent: string,
    fraction: float,
    drinks: int,
    // "Next reminder 14:30", "Reminders off", "Goal reached"...
    next: string,
    // "60 min · 09:00–21:00": how often, between when.
    hours-text: string,
    hours: [HourBar],
    // A reminder is due now.
    due: bool,
}

// Prayer: one of the five on the day's line (evenly spaced), its label
// right under its dot.
export struct PrayerMark {
    name: string,
    time: string,
    dot-x: length,
    past: bool,
    next: bool,
}

export struct PrayerView {
    next-name: string,
    // "03:13:42" until the next prayer.
    countdown: string,
    // "15:01 today", "04:04 tomorrow".
    when: string,
    place: string,
    // "Imsak 03:54 · Terbit 05:21 · Qibla 295° WNW".
    info: string,
    now-text: string,
    // Between the two prayers' dots around now, by time.
    now-x: length,
    // The line runs from the first dot to the last.
    track-from: length,
    track-to: length,
    marks: [PrayerMark],
}

export struct TaskRow {
    id: int,
    text: string,
    done: bool,
}

// A cleared task in the to-do log. `day` ("Today", "8 Nov") only on the
// first row of each day.
export struct DoneRow {
    day: string,
    time: string,
    text: string,
}

export struct ShelfRow {
    name: string,
    detail: string,
}

export struct NotifRow {
    app: string,
    title: string,
    body: string,
    time: string,
    accent: color,
    // The first letter of the app, for its round icon.
    initial: string,
    // The app's real logo (rounded by Rust), when Windows has one.
    logo: image,
    has-logo: bool,
}

// A question from Claude Code waiting for Allow / Deny, at the top of the
// Notifications page: "Allow Bash?", the project, the command.
export struct AskRow {
    id: string,
    title: string,
    project: string,
    command: string,
    accent: color,
    initial: string,
    logo: image,
    has-logo: bool,
}

export struct LyricLine {
    text: string,
    // A Japanese line's reading in Latin letters ("" otherwise), shown under it.
    romaji: string,
    current: bool,
}

export struct Music {
    has-session: bool,
    title: string,
    artist: string,
    app: string,
    playing: bool,
    position: float,
    elapsed: string,
    remaining: string,
    has-art: bool,
    art: image,
    // The cover's colour (none for a grey or dark one).
    has-accent: bool,
    accent: color,
    has-lyrics: bool,
    // Every line of the song; the one being sung (-1: not yet) and the one
    // the list centres on.
    lyrics: [LyricLine],
    lyric-index: int,
    lyric-center: int,
    lyrics-note: string,
    // "+2.0 s" when the lines are shifted (an intro, or the user's nudge).
    lyrics-shift: string,
    can-shuffle: bool,
    shuffle: bool,
    can-repeat: bool,
    // 0 off, 1 all, 2 one.
    repeat: int,
    // 1 liked, -1 disliked, 0 neither.
    rating: int,
}

// ── Mini Island's look ───────────────────────────────────────────────────────

// Rust sets these from Settings → Appearance → Look (a light body takes
// dark ink; at night everything eases warmer); the defaults are Mini Island's.
export global Mini {
    // Text: white, then three greys (a popup's message, a list's message and
    // an artist, labels and times), and the faintest (Clear all, the gear).
    in-out property <color> ink: #ffffff;
    in-out property <color> text-2: #d2d2d7;
    in-out property <color> text-3: #c2c2c7;
    in-out property <color> label: #b4b4ba;
    in-out property <color> faint: #a1a1a6;
    // The body (near black, 95 % solid) and its edge.
    in-out property <color> base: #0b0b0d;
    in-out property <float> solid: 0.949;
    // The closed island's share of `solid` while nothing asks for attention.
    in-out property <float> closed: 1;
    // Fills, rings and lines over the body: white on a dark body, black on a light one.
    in-out property <color> wash: #ffffff;
    // The body is light (white, yellow, pink): app colours get darker to read.
    in-out property <bool> light;
    // Fills over a light body need more ink than over a dark one to show as much.
    out property <float> wk: self.light ? 1.9 : 1;
    out property <color> edge: self.wash.with-alpha(0.16 * self.wk);
    // Status colours (next prayer, charging, Caps Lock, counts): Apple's on a
    // dark body, deeper ones on a light body so they still read there.
    out property <color> good: self.light ? #1a8f3c : #30d158;
    out property <color> warn: self.light ? #b86a00 : #ff9f0a;
    out property <color> bad: self.light ? #d1291f : #ff453a;
    // Marks that are neither (a later prayer's dot): a grey for the body.
    out property <color> mute: self.light ? #8a8a90 : #8e8e93;
    // The open list's colour (notifications, accounts).
    out property <color> neutral: #6e6e76;
    // The hidden island's handle.
    out property <color> handle: #9a9aa0;
    out property <string> icons: "Segoe Fluent Icons";
    // The capsule's size setting: "Extra large".
    out property <float> k: 1.5;
}

global Paint {
    // An app's or a song's colour used for text: moved toward white until it
    // reads on the dark island.
    public pure function readable(c: color) -> color {
        let l = (0.2126 * c.red + 0.7152 * c.green + 0.0722 * c.blue) / 255;
        // On a light body: toward black instead, until it reads there.
        if Mini.light {
            if l <= 0.4 {
                return c;
            }
            let d = 0.4 / l;
            return rgb(c.red * d, c.green * d, c.blue * d);
        }
        if l >= 0.62 {
            return c;
        }
        let t = (0.62 - l) / (1 - l);
        return rgb(c.red + (255 - c.red) * t, c.green + (255 - c.green) * t, c.blue + (255 - c.blue) * t);
    }
    // Toward white by t (0..1).
    public pure function lift(c: color, t: float) -> color {
        return rgb(c.red + (255 - c.red) * t, c.green + (255 - c.green) * t, c.blue + (255 - c.blue) * t);
    }
    // Darker by f (a share of each channel).
    public pure function shade(c: color, f: float) -> color {
        return rgb(c.red * f, c.green * f, c.blue * f);
    }
}

// Segoe Fluent Icons' glyphs (the ones Mini Island uses).
global Glyphs {
    out property <string> bell: "\u{EA8F}";
    out property <string> music: "\u{EC4F}";
    out property <string> lyrics: "\u{E8E4}";
    out property <string> people: "\u{E716}";
    out property <string> desktop: "\u{E7F4}";
    out property <string> prompt: "\u{E756}";
    out property <string> code: "\u{E943}";
    out property <string> gear: "\u{E713}";
    out property <string> prev: "\u{E892}";
    out property <string> next: "\u{E893}";
    out property <string> play: "\u{E768}";
    out property <string> pause: "\u{E769}";
    out property <string> note: "\u{E8D6}";
    out property <string> volume: "\u{E767}";
    out property <string> pin: "\u{E718}";
    out property <string> pinned: "\u{E840}";
    out property <string> moon: "\u{E708}";
    out property <string> video: "\u{E714}";
    out property <string> line: "\u{E90B}";
    out property <string> place: "\u{E81D}";
    // Not in Segoe Fluent: a mosque, drawn (a dome, its spire, a door).
    out property <string> mosque: "M 3 20.5 H 21 M 6 20.5 V 13.5 A 6 6 0 0 1 18 13.5 V 20.5 M 12 7.5 V 4 M 10.5 20.5 V 17.5 A 1.5 1.5 0 0 1 13.5 17.5 V 20.5";
    public pure function tab(id: string) -> string {
        return id == "notifications" ? "\u{EA8F}" : id == "music" ? "\u{EC4F}" : id == "lyrics" ? "\u{E8E4}" : id == "accounts" ? "\u{E716}" : "\u{E8D6}";
    }
    public pure function service(title: string) -> string {
        return title == "Claude Desktop" ? "\u{E7F4}" : title == "Claude Code" ? "\u{E756}" : "\u{E943}";
    }
}

// ── Small parts ──────────────────────────────────────────────────────────────

component Glyph inherits Text {
    width: 100%;
    height: 100%;
    font-family: Mini.icons;
    horizontal-alignment: center;
    vertical-alignment: center;
}

// A horizontal fade inside a rounded shape: the colour strongest at one end,
// gone after `span` of the width. The software renderer neither rounds
// gradients nor clips round, so it is a stretched strip (assets/fade.png)
// laid in rectangles that stay inside the rounded shape, plus a quarter disc
// in each corner on the strong side.
component Fade inherits Rectangle {
    in property <color> tint;
    in property <float> strength;
    // The rounded shape's corner radius.
    in property <length> r;
    in property <float> span: 1;
    // Strongest at the right end.
    in property <bool> mirror;
    // Whole pixels: a corner and the band beside it meet without a seam.
    property <length> rr: floor(min(self.r, self.height / 2) / 1px) * 1px;
    property <length> sw: max(self.rr + 1px, self.width * self.span);
    // How far into the 128-pixel strip a corner reaches.
    property <int> skip: min(127, round(128 * self.rr / self.sw));
    Image {
        x: root.mirror ? root.width - root.sw : 0px;
        y: root.rr;
        width: root.sw;
        height: max(0px, root.height - 2 * root.rr);
        source: root.mirror ? @image-url("../assets/fade-r.png") : @image-url("../assets/fade.png");
        image-fit: fill;
        colorize: root.tint;
        opacity: root.strength;
    }
    for band in 2 : Image {
        x: root.mirror ? root.width - root.sw : root.rr;
        y: band == 0 ? 0px : root.height - root.rr;
        width: max(0px, root.sw - root.rr);
        height: root.rr;
        source: root.mirror ? @image-url("../assets/fade-r.png") : @image-url("../assets/fade.png");
        source-clip-x: root.mirror ? 0 : root.skip;
        source-clip-width: 128 - root.skip;
        image-fit: fill;
        colorize: root.tint;
        opacity: root.strength;
    }
    for corner in 2 : Path {
        x: root.mirror ? root.width - root.rr : 0px;
        y: corner == 0 ? 0px : root.height - root.rr;
        width: root.rr;
        height: root.rr;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 1;
        viewbox-height: 1;
        commands: root.mirror
            ? (corner == 0 ? "M 0 1 L 1 1 A 1 1 0 0 0 0 0 Z" : "M 0 0 L 1 0 A 1 1 0 0 1 0 1 Z")
            : (corner == 0 ? "M 1 1 L 0 1 A 1 1 0 0 1 1 0 Z" : "M 1 0 L 0 0 A 1 1 0 0 0 1 1 Z");
        // The strip's alpha where the band beside it starts: no step between them.
        fill: root.tint.with-alpha(root.strength * (1 - root.rr / root.sw));
        stroke: transparent;
    }
}

// Mini Island's row and card fill: the colour from the left, faint by three
// quarters, and (lit) a touch of white at the right end.
component Tinted inherits Rectangle {
    in property <color> tint;
    in property <bool> lit;
    border-radius: 14px;
    background: root.lit ? Mini.wash.with-alpha(min(1, 0.02 * Mini.wk)) : transparent;
    Fade {
        width: parent.width;
        height: parent.height;
        r: root.border-radius;
        tint: root.tint;
        strength: root.lit ? 0.37 : 0.18;
        span: root.lit ? 1.0 : 0.95;
    }
    if root.lit : Fade {
        width: parent.width;
        height: parent.height;
        r: root.border-radius;
        tint: Mini.wash;
        strength: 0.06;
        span: 0.25;
        mirror: true;
    }
}

// An app's icon: its real logo (a rounded square, the corners cut in the
// picture: the software renderer clips square), else a disc in its colour
// with its first letter.
component AppIcon inherits Rectangle {
    in property <color> accent;
    in property <string> initial;
    in property <image> logo;
    in property <bool> has-logo;
    in property <length> size: 34px;
    width: root.size;
    height: root.size;
    border-radius: root.size / 2;
    background: root.has-logo ? transparent : root.accent;
    if root.has-logo : Image { width: parent.width; height: parent.height; source: root.logo; image-fit: contain; }
    if !root.has-logo : Text {
        width: 100%;
        height: 100%;
        text: root.initial == "" ? "?" : root.initial;
        color: Mini.ink;
        font-size: root.size * 0.45;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// The song's cover, rounded (Rust rounds the picture's corners: the software
// renderer clips square), or a note on the song's colour.
component Cover inherits Rectangle {
    in property <Music> music;
    in property <color> accent;
    in property <length> size: 40px;
    in property <length> glyph-size: 16px;
    width: root.size;
    height: root.size;
    border-radius: root.size / 4;
    background: root.music.has-art ? transparent : Paint.shade(root.accent, 0.6);
    if root.music.has-art : Image { source: root.music.art; width: parent.width; height: parent.height; image-fit: cover; }
    if !root.music.has-art : Glyph { text: Glyphs.note; font-size: root.glyph-size; color: Mini.ink; }
}

// Three bars that bob while music plays (Mini Island's "bars"), each on its
// own beat, rising from the bottom.
component Equalizer inherits Rectangle {
    in property <bool> playing;
    in property <color> tint: Mini.ink;
    in property <length> bar-w: 3px;
    in property <length> bar-h: 12px;
    width: 3 * (root.bar-w + root.bar-w * 2 / 3);
    height: root.bar-h;
    for i in [0, 1, 2] : Rectangle {
        property <float> beat: [420, 560, 360][i];
        property <float> phase: root.playing ? mod((animation-tick() / 1ms + 3000 - i * 90) / self.beat, 2) : 0;
        property <float> level: root.playing ? 0.3 + 0.7 * (self.phase < 1 ? self.phase : 2 - self.phase) : 0.35;
        x: root.bar-w / 3 + i * (root.bar-w + root.bar-w * 2 / 3);
        width: root.bar-w;
        height: root.bar-h * self.level;
        y: root.height - self.height;
        border-radius: root.bar-w / 2;
        background: root.tint;
    }
}

// The song's progress as water, after Mini Island's: three layers of waves
// in the cover's colour ride the played part of the bar, slow and long at the
// back, short and quicker in front; they swell and settle on their own and
// lie down when the song pauses. Redrawn 20 times a second, only while
// playing on screen. The bar is the song's colour, the rest a thin line, the
// knob the song's colour in a white ring.
component WaveBar inherits Rectangle {
    in property <float> value;
    in property <bool> playing;
    // On screen: the clock runs only then.
    in property <bool> live;
    in property <color> tint: Mini.ink;
    // The small one (the capsule): a thin bar, a small knob, no waves.
    in property <bool> small;
    height: root.small ? 9px : 22px;
    property <length> bar-h: root.small ? 2px : 4px;
    property <length> knob: root.small ? 5px : 11px;
    // The bar's middle, near the bottom; the waves rise above it.
    property <float> base: self.height / 1px - (root.small ? 1.5 : 0) - self.bar-h / 1px / 2;
    property <float> fill: max(0, self.width / 1px * clamp(root.value, 0, 1));
    animate fill { duration: 300ms; easing: ease-out; }
    property <float> t;
    Timer {
        interval: 50ms;
        running: root.playing && root.live && !root.small;
        triggered => { root.t = animation-tick() / 1ms / 1000; }
    }
    property <float> calm: root.playing ? 1 : 0.4;
    animate calm { duration: 700ms; easing: ease-in-out; }

    pure function px(i: int, x0: float, x1: float) -> float { return x0 + (x1 - x0) * i / 24; }
    pure function smooth(u: float) -> float { return u <= 0 ? 0 : u >= 1 ? 1 : u * u * (3 - 2 * u); }
    pure function py(i: int, l: int, x0: float, x1: float, t: float, a: float) -> float {
        let x = root.px(i, x0, x1);
        let tap = max(1, min(22, (x1 - x0) * 0.4));
        let env = root.smooth((x - x0) / tap) * root.smooth((x1 - x) / tap);
        let w1 = (1 - cos(360deg * (x - [16, 22, 30][l] * t + [13, 0, 31][l]) / [110, 84, 62][l])) / 2;
        let w2 = (1 - cos(360deg * (x - [23, 30, 40][l] * t + [48, 22, 9][l]) / [63, 49, 37][l])) / 2;
        return root.base - a * env * (0.3 + 0.7 * pow(0.7 * w1 + 0.3 * w2, [1.2, 1.35, 1.5][l]));
    }
    pure function layer(l: int, t: float, a: float) -> string {
        let x0 = root.fill * [0, 0.05, 0.12][l];
        let x1 = root.fill * [1, 0.95, 0.86][l];
        return "M " + x0 + " " + root.base + " L " + root.px(0, x0, x1) + " " + root.py(0, l, x0, x1, t, a) + " L " + root.px(1, x0, x1) + " " + root.py(1, l, x0, x1, t, a) + " L " + root.px(2, x0, x1) + " " + root.py(2, l, x0, x1, t, a) + " L " + root.px(3, x0, x1) + " " + root.py(3, l, x0, x1, t, a) + " L " + root.px(4, x0, x1) + " " + root.py(4, l, x0, x1, t, a) + " L " + root.px(5, x0, x1) + " " + root.py(5, l, x0, x1, t, a) + " L " + root.px(6, x0, x1) + " " + root.py(6, l, x0, x1, t, a) + " L " + root.px(7, x0, x1) + " " + root.py(7, l, x0, x1, t, a) + " L " + root.px(8, x0, x1) + " " + root.py(8, l, x0, x1, t, a) + " L " + root.px(9, x0, x1) + " " + root.py(9, l, x0, x1, t, a) + " L " + root.px(10, x0, x1) + " " + root.py(10, l, x0, x1, t, a) + " L " + root.px(11, x0, x1) + " " + root.py(11, l, x0, x1, t, a) + " L " + root.px(12, x0, x1) + " " + root.py(12, l, x0, x1, t, a) + " L " + root.px(13, x0, x1) + " " + root.py(13, l, x0, x1, t, a) + " L " + root.px(14, x0, x1) + " " + root.py(14, l, x0, x1, t, a) + " L " + root.px(15, x0, x1) + " " + root.py(15, l, x0, x1, t, a) + " L " + root.px(16, x0, x1) + " " + root.py(16, l, x0, x1, t, a) + " L " + root.px(17, x0, x1) + " " + root.py(17, l, x0, x1, t, a) + " L " + root.px(18, x0, x1) + " " + root.py(18, l, x0, x1, t, a) + " L " + root.px(19, x0, x1) + " " + root.py(19, l, x0, x1, t, a) + " L " + root.px(20, x0, x1) + " " + root.py(20, l, x0, x1, t, a) + " L " + root.px(21, x0, x1) + " " + root.py(21, l, x0, x1, t, a) + " L " + root.px(22, x0, x1) + " " + root.py(22, l, x0, x1, t, a) + " L " + root.px(23, x0, x1) + " " + root.py(23, l, x0, x1, t, a) + " L " + root.px(24, x0, x1) + " " + root.py(24, l, x0, x1, t, a) + " L " + x1 + " " + root.base + " Z";
    }
    pure function amp(l: int) -> float {
        return min(1, root.fill * 0.11 / 12) * [9, 7.5, 6][l] * root.calm * (0.72 + 0.28 * sin(root.t * [0.6, 0.9, 1.3][l] * 1rad + [1, 0, 2.1][l] * 1rad));
    }

    // The rest of the song: a thin line.
    Rectangle {
        x: 0;
        y: root.base * 1px - self.height / 2;
        width: parent.width;
        height: root.small ? 1px : 2px;
        border-radius: self.height / 2;
        background: Mini.wash.with-alpha(min(1, 0.22 * Mini.wk));
    }
    if !root.small : Rectangle {
        width: parent.width;
        height: parent.height;
        for l in [0, 1, 2] : Path {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            viewbox-x: 0;
            viewbox-y: 0;
            viewbox-width: parent.width / 1px;
            viewbox-height: parent.height / 1px;
            commands: root.layer(l, root.t, root.amp(l));
            fill: [Paint.lift(root.tint, 0.5).with-alpha(0.30), Paint.lift(root.tint, 0.2).with-alpha(0.40), root.tint.with-alpha(0.55)][l];
            stroke: transparent;
        }
    }
    // The played part.
    Rectangle {
        x: 0;
        y: root.base * 1px - self.height / 2;
        width: root.fill * 1px;
        height: root.bar-h;
        border-radius: root.bar-h / 2;
        background: root.tint;
    }
    // The knob where the song is: the song's colour in a white ring.
    Rectangle {
        x: root.fill * 1px - root.knob / 2;
        y: root.base * 1px - root.knob / 2;
        width: root.knob;
        height: root.knob;
        border-radius: root.knob / 2;
        background: root.tint;
        border-width: root.small ? 1.2px : 2px;
        border-color: Mini.wash;
    }
}

// The volume: a track, the part up to the level in the song's colour, a
// white knob.
component VolumeSlider inherits Rectangle {
    in property <float> value;
    in property <color> tint;
    height: 18px;
    Rectangle { y: (parent.height - self.height) / 2; height: 4px; border-radius: 2px; background: Mini.wash.with-alpha(min(1, 0.2 * Mini.wk)); }
    Rectangle {
        x: 0;
        y: (parent.height - self.height) / 2;
        width: parent.width * clamp(root.value, 0, 1);
        height: 4px;
        border-radius: 2px;
        background: root.tint;
    }
    Rectangle {
        x: parent.width * clamp(root.value, 0, 1) - self.width / 2;
        y: (parent.height - self.height) / 2;
        width: 11px;
        height: 11px;
        border-radius: 5.5px;
        background: Mini.wash;
    }
}

// A round media button: clear until pointed at (`ring`: always a faint disc).
component MediaButton inherits Rectangle {
    in property <string> glyph;
    in property <length> glyph-size: 12px;
    in property <bool> ring;
    callback clicked();
    width: 28px;
    height: 28px;
    border-radius: 14px;
    background: area.has-hover || root.ring ? Mini.wash.with-alpha(min(1, 0.18 * Mini.wk)) : transparent;
    animate background { duration: 120ms; }
    Glyph { text: root.glyph; font-size: root.glyph-size; color: Mini.ink; }
    area := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// A small round toggle (the lyrics card's あ, Ro and pin).
component PageToggle inherits Rectangle {
    in property <string> label;
    in property <bool> glyph;
    in property <bool> on;
    callback clicked();
    width: 24px;
    height: 24px;
    border-radius: 12px;
    background: area.has-hover ? Mini.wash.with-alpha(min(1, 0.4 * Mini.wk)) : root.on ? (Mini.light ? #ffffff : Mini.wash.with-alpha(0.333)) : Mini.wash.with-alpha(min(1, 0.149 * Mini.wk));
    animate background { duration: 120ms; }
    if root.glyph : Glyph { text: root.label; font-size: 11px; color: root.on ? Mini.ink : Mini.wash.with-alpha(min(1, 0.6 * Mini.wk)); }
    if !root.glyph : Text {
        width: 100%;
        height: 100%;
        text: root.label;
        font-size: 10.5px;
        font-weight: 600;
        color: root.on ? Mini.ink : Mini.wash.with-alpha(min(1, 0.6 * Mini.wk));
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    area := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// The top bar's round quick buttons (Do not disturb, notifications, the
// gear, a docked video): a faint disc, lighter when pointed at or on; an
// optional red count in the corner.
component QuickButton inherits Rectangle {
    in property <string> glyph;
    in property <bool> on;
    in property <int> badge;
    callback clicked();
    callback right-clicked();
    width: 30px;
    height: 30px;
    border-radius: 15px;
    background: root.on ? (Mini.light ? #ffffff : Mini.wash.with-alpha(0.251)) : area.has-hover ? Mini.wash.with-alpha(min(1, 0.18 * Mini.wk)) : Mini.wash.with-alpha(min(1, 0.078 * Mini.wk));
    animate background { duration: 180ms; }
    Glyph { text: root.glyph; font-size: 13px; color: area.has-hover || root.on ? Mini.ink : Mini.text-3; animate color { duration: 180ms; } }
    if root.badge > 0 : Rectangle {
        x: parent.width - self.width + 4px;
        y: -3px;
        width: max(15px, badge-text.preferred-width + 8px);
        height: 15px;
        border-radius: 7.5px;
        background: #ff453a;
        border-width: 1.5px;
        border-color: Mini.base;
        badge-text := Text {
            width: 100%;
            height: 100%;
            text: root.badge > 9 ? "9+" : root.badge;
            color: Mini.ink;
            font-size: 9px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    area := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        pointer-event(e) => {
            if e.button == PointerEventButton.right && e.kind == PointerEventKind.up {
                root.right-clicked();
            }
        }
    }
}

// The icon of a system notice in the capsule: headphones, the charger's
// bolt (green), Caps Lock (amber when on), a device that went away dimmed.
component SysIcon inherits Path {
    in property <string> name;
    width: 16px;
    height: 16px;
    viewbox-width: 24;
    viewbox-height: 24;
    stroke-width: 1.8px;
    stroke: name == "bolt" || name == "prayer" ? Mini.good : name == "caps-on" ? Mini.warn
        : (name == "headphones-off" || name == "wifi-off" || name == "volume-off" || name == "caps-off") ? Mini.label : Mini.ink;
    commands: name == "prayer" ? Glyphs.mosque
        : name == "headphones" ? "M 4 15 V 12 A 8 8 0 0 1 20 12 V 15 M 4 15 H 7 V 20 H 4 Z M 20 15 H 17 V 20 H 20 Z"
        : name == "headphones-off" ? "M 4 15 V 12 A 8 8 0 0 1 20 12 V 15 M 4 15 H 7 V 20 H 4 Z M 20 15 H 17 V 20 H 20 Z M 3 3 L 21 21"
        : name == "bolt" ? "M 13 2 L 5 13 H 11 L 10 22 L 19 10 H 13 Z"
        : name == "battery" ? "M 3 8 H 18 V 16 H 3 Z M 21 11 V 13 M 6 11 V 13"
        : name == "wifi" ? "M 2 9 A 15 15 0 0 1 22 9 M 5 12.5 A 10 10 0 0 1 19 12.5 M 8.5 16 A 5 5 0 0 1 15.5 16 M 12 19.5 V 20"
        : name == "ethernet" ? "M 4 5 H 20 V 15 H 4 Z M 8 15 V 19 H 16 V 15 M 8 9 V 11 M 11 9 V 11 M 13 9 V 11 M 16 9 V 11"
        : name == "wifi-off" ? "M 2 9 A 15 15 0 0 1 22 9 M 5 12.5 A 10 10 0 0 1 19 12.5 M 8.5 16 A 5 5 0 0 1 15.5 16 M 3 3 L 21 21"
        : name == "keyboard" ? "M 3 6 H 21 V 18 H 3 Z M 7 10 H 8 M 11 10 H 12 M 15 10 H 16 M 8 14 H 16"
        : name == "caps-on" || name == "caps-off" ? "M 12 4 L 4 13 H 8 V 19 H 16 V 13 H 20 Z"
        : name == "volume-off" ? "M 4 9 H 8 L 13 5 V 19 L 8 15 H 4 Z M 16 9 L 21 14 M 21 9 L 16 14"
        : "M 4 9 H 8 L 13 5 V 19 L 8 15 H 4 Z M 16 9 A 4 4 0 0 1 16 15 M 18.5 6.5 A 7.5 7.5 0 0 1 18.5 17.5";
}

// The idle island's battery: an outline filled to the level (red at 20 %
// or less, green while charging), as Windows' own tray icon.
component BatteryIcon inherits Rectangle {
    in property <float> level;
    in property <bool> charging;
    width: 22px;
    height: 12px;
    Rectangle {
        x: 0; y: 0; width: 20px; height: 12px;
        border-radius: 3px;
        border-width: 1.2px;
        border-color: Mini.text-2;
        Rectangle {
            x: 2px; y: 2px; height: parent.height - 4px;
            width: max(1px, (parent.width - 4px) * clamp(root.level, 0, 1));
            border-radius: 1.5px;
            background: root.charging ? Mini.good : root.level <= 0.2 ? Mini.bad : Mini.ink;
        }
    }
    Rectangle { x: 20.5px; y: 4px; width: 1.5px; height: 4px; background: Mini.text-2; }
}

// One side of the idle island: the date, the connection, or the battery.
component IdleSlot inherits HorizontalLayout {
    in property <string> kind;
    in property <string> date;
    in property <string> net;
    in property <string> battery;
    in property <float> level;
    in property <bool> charging;
    spacing: 5px;
    if root.kind == "date" : Text { text: root.date; color: Mini.text-2; font-size: 13px; font-weight: 600; vertical-alignment: center; }
    if root.kind == "network" : SysIcon { name: root.net; y: (parent.height - self.height) / 2; }
    if root.kind == "battery" : BatteryIcon { level: root.level; charging: root.charging; y: (parent.height - self.height) / 2; }
    if root.kind == "battery" : Text { text: root.battery; color: Mini.text-2; font-size: 13px; font-weight: 600; vertical-alignment: center; }
}

// A small pill for a question's answers.
component ActionPill inherits Rectangle {
    in property <string> label;
    callback clicked();
    width: t.preferred-width + 20px;
    height: 24px;
    border-radius: 12px;
    background: area.has-hover ? Mini.wash.with-alpha(min(1, 0.333 * Mini.wk)) : Mini.wash.with-alpha(min(1, 0.2 * Mini.wk));
    animate background { duration: 120ms; }
    t := Text { x: 10px; width: self.preferred-width; height: 100%; vertical-alignment: center; text: root.label; color: Mini.ink; font-size: 11.5px; font-weight: 600; }
    area := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

component Bar inherits Rectangle {
    in property <float> value;
    in property <color> tint: Mini.ink;
    height: 4px;
    border-radius: 2px;
    background: Mini.wash.with-alpha(min(1, 0.2 * Mini.wk));
    Rectangle {
        x: 0;
        width: max(parent.height, parent.width * clamp(root.value, 0, 1));
        height: parent.height;
        border-radius: parent.border-radius;
        background: root.tint;
        animate width { duration: 300ms; easing: ease-out; }
    }
}

// A page that fades in when its tab is chosen.
component Page inherits Rectangle {
    in property <bool> shown;
    opacity: shown ? 1 : 0;
    animate opacity { duration: Ice.fade; easing: ease-out; }
    visible: self.opacity > 0.01;
}

// ── The capsule's song (Mini Island's small pill) ────────────────────────────

// Title · artist running left forever inside the pill, its ends fading,
// with the song's progress small underneath.
component Marquee inherits Rectangle {
    in property <Music> music;
    in property <color> accent;
    in property <bool> live;
    property <string> line: root.music.artist == "" ? root.music.title : root.music.title + "  ·  " + root.music.artist;
    property <length> gap: 28px;
    // 22 px a second (Mini Island's speed, at the pill's size).
    property <float> speed: 22;
    property <length> cycle: probe.preferred-width + self.gap;
    property <float> shift: root.live ? mod(animation-tick() / 1ms / 1000 * self.speed, max(1, self.cycle / 1px)) : 0;
    probe := Text { visible: false; text: root.line; font-size: 11px; font-weight: 600; }
    // The ends fade over 16 % of the width each (Mini Island's opacity
    // mask): the software renderer has no masks, so the text is laid in
    // strips, each clipped and a little more opaque toward the middle.
    for strip in [
        { from: 0, span: 0.04, alpha: 0.125 }, { from: 0.04, span: 0.04, alpha: 0.375 },
        { from: 0.08, span: 0.04, alpha: 0.625 }, { from: 0.12, span: 0.04, alpha: 0.875 },
        { from: 0.16, span: 0.68, alpha: 1 },
        { from: 0.84, span: 0.04, alpha: 0.875 }, { from: 0.88, span: 0.04, alpha: 0.625 },
        { from: 0.92, span: 0.04, alpha: 0.375 }, { from: 0.96, span: 0.04, alpha: 0.125 },
    ] : Rectangle {
        x: root.width * strip.from;
        y: 0;
        width: root.width * strip.span;
        height: 15px;
        clip: true;
        opacity: strip.alpha;
        for copy in 2 : Text {
            x: copy * root.cycle - root.shift * 1px - root.width * strip.from;
            width: self.preferred-width;
            y: 0;
            height: parent.height;
            text: root.line;
            color: Mini.wash.with-alpha(min(1, 0.851 * Mini.wk));
            font-size: 11px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
    WaveBar {
        x: 1px;
        y: 15px;
        width: parent.width - 2px;
        small: true;
        value: root.music.position;
        playing: root.music.playing;
        tint: root.accent;
    }
}

// ── Pages of the open list ───────────────────────────────────────────────────

// The music card: cover, title (and the bars) and artist, the controls, and
// underneath the volume (when the player's level is known) or the song's
// progress. Mini Island's card, at the open list's size and in its popup.
component MusicCard inherits Rectangle {
    in property <Music> music;
    in property <color> accent;
    in property <float> volume;
    in property <bool> live;
    in property <bool> line-held;
    in property <bool> card: true;
    callback command(string);
    height: 86px;
    if root.card : Tinted { width: parent.width; height: parent.height; tint: root.accent; lit: true; }
    Cover { x: 10px; y: 10px; music: root.music; accent: root.accent; }
    // Title and artist between the cover and the controls.
    Rectangle {
        x: 60px;
        y: 10px;
        width: parent.width - 60px - 6px - 84px - 12px;
        height: 40px;
        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                spacing: 6px;
                Text { text: root.music.title; color: Mini.ink; font-size: 13px; font-weight: 600; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
                Equalizer { playing: root.music.playing; tint: Paint.readable(root.accent); y: (parent.height - self.height) / 2; }
            }
            Text { text: root.music.artist; color: Mini.text-3; font-size: 12px; overflow: elide; }
        }
    }
    HorizontalLayout {
        x: parent.width - 12px - 84px;
        y: 16px;
        width: 84px;
        height: 28px;
        MediaButton { glyph: Glyphs.prev; clicked => { root.command("previous"); } }
        MediaButton { glyph: root.music.playing ? Glyphs.pause : Glyphs.play; glyph-size: 15px; ring: true; clicked => { root.command("play-pause"); } }
        MediaButton { glyph: Glyphs.next; clicked => { root.command("next"); } }
    }
    // The volume row: speaker, slider, level.
    if root.volume >= 0 : HorizontalLayout {
        x: 12px;
        y: 58px;
        width: parent.width - 28px;
        height: 24px;
        Rectangle {
            width: 24px;
            Glyph { text: Glyphs.volume; font-size: 12px; color: Mini.wash.with-alpha(min(1, 0.902 * Mini.wk)); }
        }
        VolumeSlider { horizontal-stretch: 1; value: root.volume; tint: Paint.lift(root.accent, 0.35); y: (parent.height - self.height) / 2; }
        Rectangle { width: 2px; }
        Text { text: round(root.volume * 100) + "%"; color: Mini.text-2; font-size: 10.5px; min-width: 32px; horizontal-alignment: right; vertical-alignment: center; }
    }
    // The song's progress: time, the wave, length, and the lyric switch.
    if root.volume < 0 : HorizontalLayout {
        x: 16px;
        y: 58px;
        width: parent.width - 32px;
        height: 24px;
        Text { text: root.music.elapsed; color: Mini.text-2; font-size: 10.5px; min-width: 28px; vertical-alignment: center; }
        WaveBar {
            horizontal-stretch: 1;
            y: 24px / 2 + 2px - self.height;
            value: root.music.position;
            playing: root.music.playing;
            live: root.live;
            tint: root.accent;
        }
        Rectangle { width: 6px; }
        Text { text: root.music.remaining; color: Mini.text-2; font-size: 10.5px; min-width: 28px; horizontal-alignment: right; vertical-alignment: center; }
        // Line: the song's lyric on the capsule (Mini Island's lyric switch).
        Rectangle {
            width: 28px;
            Rectangle {
                x: 6px;
                y: (parent.height - self.height) / 2;
                width: 22px;
                height: 22px;
                border-radius: 11px;
                background: line-area.has-hover ? Mini.wash.with-alpha(min(1, 0.2 * Mini.wk)) : root.line-held ? Mini.wash.with-alpha(min(1, 0.251 * Mini.wk)) : transparent;
                Glyph { text: Glyphs.line; font-size: 11px; color: root.line-held ? Mini.ink : Mini.wash.with-alpha(min(1, 0.702 * Mini.wk)); }
                line-area := TouchArea { mouse-cursor: pointer; clicked => { root.command("line-hold"); } }
            }
        }
    }
}

// The open island's Music page, laid across its width: a big cover on the
// left; the title (and the bars), artist and player beside it; the controls
// and (when the player's level is known) the volume on the right; the song's
// progress along the bottom with the lyric switch.
component MusicWide inherits Rectangle {
    in property <Music> music;
    in property <color> accent;
    in property <float> volume;
    in property <bool> live;
    in property <bool> line-held;
    callback command(string);
    property <length> pad: 14px;
    property <length> cover: self.height - 2 * self.pad;
    property <length> text-x: self.pad + self.cover + 16px;
    property <length> controls-w: 3 * 34px + 2 * 6px;
    property <length> volume-w: root.volume >= 0 ? 170px : 0px;
    Tinted { width: parent.width; height: parent.height; tint: root.accent; lit: true; }
    Cover { x: root.pad; y: root.pad; size: root.cover; glyph-size: 30px; music: root.music; accent: root.accent; }
    VerticalLayout {
        x: root.text-x;
        y: root.pad;
        width: root.width - root.text-x - root.pad - root.controls-w - root.volume-w - 16px;
        height: 56px;
        alignment: start;
        spacing: 1px;
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            Text { text: root.music.title; color: Mini.ink; font-size: 17px; font-weight: 700; overflow: elide; vertical-alignment: center; }
            Equalizer { playing: root.music.playing; tint: Paint.readable(root.accent); y: (parent.height - self.height) / 2; }
        }
        Text { text: root.music.artist; color: Mini.text-3; font-size: 13px; overflow: elide; }
        if root.music.app != "" : Text { text: root.music.app; color: Mini.label; font-size: 11px; overflow: elide; }
    }
    // The volume row: speaker, slider, level.
    if root.volume >= 0 : HorizontalLayout {
        x: root.width - root.pad - root.controls-w - 14px - root.volume-w;
        y: root.pad + 5px;
        width: root.volume-w;
        height: 24px;
        spacing: 4px;
        Rectangle { width: 18px; Glyph { text: Glyphs.volume; font-size: 12px; color: Mini.wash.with-alpha(min(1, 0.902 * Mini.wk)); } }
        VolumeSlider { horizontal-stretch: 1; value: root.volume; tint: Paint.lift(root.accent, 0.35); y: (parent.height - self.height) / 2; }
        Text { text: round(root.volume * 100) + "%"; color: Mini.text-2; font-size: 10.5px; min-width: 32px; horizontal-alignment: right; vertical-alignment: center; }
    }
    HorizontalLayout {
        x: root.width - root.pad - root.controls-w;
        y: root.pad;
        width: root.controls-w;
        height: 34px;
        spacing: 6px;
        MediaButton { width: 34px; height: 34px; border-radius: 17px; glyph: Glyphs.prev; glyph-size: 13px; clicked => { root.command("previous"); } }
        MediaButton { width: 34px; height: 34px; border-radius: 17px; glyph: root.music.playing ? Glyphs.pause : Glyphs.play; glyph-size: 16px; ring: true; clicked => { root.command("play-pause"); } }
        MediaButton { width: 34px; height: 34px; border-radius: 17px; glyph: Glyphs.next; glyph-size: 13px; clicked => { root.command("next"); } }
    }
    // The song's progress: time, the wave, length, and the lyric switch.
    HorizontalLayout {
        x: root.text-x;
        y: root.height - root.pad - 26px;
        width: root.width - root.text-x - root.pad;
        height: 26px;
        Text { text: root.music.elapsed; color: Mini.text-2; font-size: 11px; min-width: 34px; vertical-alignment: center; }
        WaveBar {
            horizontal-stretch: 1;
            visible: root.music.remaining != "";
            y: 26px / 2 + 2px - self.height;
            value: root.music.position;
            playing: root.music.playing;
            live: root.live;
            tint: root.accent;
        }
        Rectangle { width: 8px; }
        Text { text: root.music.remaining; color: Mini.text-2; font-size: 11px; min-width: 34px; horizontal-alignment: right; vertical-alignment: center; }
        // Line: the song's lyric on the capsule (Mini Island's lyric switch).
        Rectangle {
            width: 34px;
            Rectangle {
                x: 8px;
                y: (parent.height - self.height) / 2;
                width: 26px;
                height: 26px;
                border-radius: 13px;
                background: line-area.has-hover ? Mini.wash.with-alpha(min(1, 0.2 * Mini.wk)) : root.line-held ? Mini.wash.with-alpha(min(1, 0.251 * Mini.wk)) : transparent;
                Glyph { text: Glyphs.line; font-size: 12px; color: root.line-held ? Mini.ink : Mini.wash.with-alpha(min(1, 0.702 * Mini.wk)); }
                line-area := TouchArea { mouse-cursor: pointer; clicked => { root.command("line-hold"); } }
            }
        }
    }
}

// Notifications: a header (how many, Clear all) and the six newest in two
// columns, each row the app's round icon, the title and message, the time.
component NotifPage inherits Rectangle {
    in property <[NotifRow]> items;
    // Claude Code's open questions, on top, one a row (the three newest).
    in property <[AskRow]> asks;
    callback clicked(int);
    callback clear();
    callback answered(string, string);
    // One column for a single notification, else two.
    property <int> cols: root.items.length == 1 ? 1 : 2;
    property <length> col-w: (root.width - (self.cols - 1) * 10px) / self.cols;
    property <int> ask-rows: min(root.asks.length, 3);
    property <length> grid-y: 28px + self.ask-rows * 50px;
    if root.items.length == 0 && root.asks.length == 0 : Text {
        width: parent.width;
        height: parent.height;
        vertical-alignment: center;
        text: "No notifications";
        color: Mini.text-3;
        font-size: 13px;
        horizontal-alignment: center;
    }
    if root.items.length > 0 || root.asks.length > 0 : Rectangle {
        x: 8px;
        y: 0;
        width: parent.width - 16px;
        height: 26px;
        Text {
            x: 0;
            width: self.preferred-width;
            height: 100%;
            text: root.items.length > 6 ? "Notifications (6 of " + root.items.length + ")" : "Notifications";
            color: Mini.label;
            font-size: 11px;
            font-weight: 600;
            vertical-alignment: center;
        }
        if root.items.length > 0 : Text {
            x: parent.width - self.width;
            width: self.preferred-width;
            height: 100%;
            text: "Clear all";
            color: clear-area.has-hover ? Mini.ink : Mini.faint;
            font-size: 11px;
            font-weight: 600;
            vertical-alignment: center;
            animate color { duration: 180ms; }
            clear-area := TouchArea { mouse-cursor: pointer; clicked => { root.clear(); } }
        }
    }
    // A question: the Claude logo, "Allow Bash?", the project and the
    // command, Allow / Deny on the right (the capsule's answers).
    for q[i] in root.asks : Rectangle {
        visible: i < 3;
        x: 0;
        y: 28px + i * 50px;
        width: root.width;
        height: 48px;
        Tinted { width: parent.width; height: parent.height; tint: q.accent; lit: true; }
        AppIcon { x: 8px; y: 9px; size: 30px; accent: q.accent; initial: q.initial; logo: q.logo; has-logo: q.has-logo; }
        VerticalLayout {
            x: 50px;
            width: parent.width - 50px - 12px - answers.preferred-width - 12px;
            alignment: center;
            Text { text: q.title; color: Mini.ink; font-size: 13px; font-weight: 600; overflow: elide; }
            Text {
                text: q.command == "" ? q.project : q.project + " · " + q.command;
                color: Mini.text-3;
                font-size: 12px;
                overflow: elide;
            }
        }
        answers := HorizontalLayout {
            x: parent.width - 12px - self.preferred-width;
            y: (parent.height - 24px) / 2;
            width: self.preferred-width;
            height: 24px;
            spacing: 6px;
            ActionPill { label: "Allow"; clicked => { root.answered(q.id, "allow"); } }
            ActionPill { label: "Deny"; clicked => { root.answered(q.id, "deny"); } }
        }
    }
    for n[i] in root.items : Rectangle {
        visible: i < 6;
        x: mod(i, root.cols) * (root.col-w + 10px);
        y: root.grid-y + floor(i / root.cols) * 50px;
        width: root.col-w;
        height: 48px;
        Tinted { width: parent.width; height: parent.height; tint: n.accent; lit: row.has-hover; }
        AppIcon { x: 8px; y: 9px; size: 30px; accent: n.accent; initial: n.initial; logo: n.logo; has-logo: n.has-logo; }
        VerticalLayout {
            x: 50px;
            width: parent.width - 50px - 10px - 44px;
            alignment: center;
            Text { text: n.title == "" ? n.app : n.title; color: Mini.ink; font-size: 13px; font-weight: 600; overflow: elide; }
            if n.body != "" : Text { text: n.body; color: Mini.text-3; font-size: 12px; overflow: elide; }
        }
        Text {
            x: parent.width - 8px - self.width;
            width: self.preferred-width;
            height: 100%;
            text: n.time;
            color: Mini.label;
            font-size: 11px;
            vertical-alignment: center;
        }
        row := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(i); } }
    }
}

// Lyrics: the whole song on a card, the line being sung bright in the
// middle, the others dim and fading toward the card's edges; furigana over
// a line and romaji under it when the lyrics have them; あ, Ro and a pin.
component LyricsPage inherits Rectangle {
    in property <Music> music;
    in property <color> accent;
    in property <bool> held;
    // The lyrics are Japanese (あ and Ro show).
    in property <bool> japanese;
    in-out property <bool> furigana: true;
    in-out property <bool> romaji: true;
    in property <bool> live;
    callback command(string);
    // The player on the left (cover and title, progress, controls), the lines beside it.
    property <length> side: 280px;
    property <length> pad: 16px;
    property <length> cover: 64px;
    Tinted { width: parent.width; height: parent.height; tint: root.accent; lit: true; }
    Cover { x: root.pad; y: root.pad; size: root.cover; glyph-size: 24px; music: root.music; accent: root.accent; }
    VerticalLayout {
        x: root.pad + root.cover + 12px;
        y: root.pad;
        width: root.side - self.x - 14px;
        height: root.cover;
        alignment: center;
        spacing: 2px;
        HorizontalLayout {
            spacing: 6px;
            Text { text: root.music.title; color: Mini.ink; font-size: 15px; font-weight: 700; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
            Equalizer { playing: root.music.playing; tint: Paint.readable(root.accent); y: (parent.height - self.height) / 2; }
        }
        Text { text: root.music.artist; color: Mini.text-3; font-size: 12.5px; overflow: elide; }
        if root.music.lyrics-shift != "" : Text { text: root.music.lyrics-shift; color: Mini.label; font-size: 10.5px; overflow: elide; }
    }
    // Progress: time, the wave, what's left.
    HorizontalLayout {
        x: root.pad;
        y: root.pad + root.cover + 12px;
        width: root.side - root.pad - 14px;
        height: 22px;
        Text { text: root.music.elapsed; color: Mini.text-2; font-size: 11px; min-width: 34px; vertical-alignment: center; }
        WaveBar {
            horizontal-stretch: 1;
            visible: root.music.remaining != "";
            y: 22px / 2 + 2px - self.height;
            value: root.music.position;
            playing: root.music.playing;
            live: root.live;
            tint: root.accent;
        }
        Rectangle { width: 8px; }
        Text { text: root.music.remaining; color: Mini.text-2; font-size: 11px; min-width: 34px; horizontal-alignment: right; vertical-alignment: center; }
    }
    // Controls, centred under the progress.
    HorizontalLayout {
        x: root.pad + (root.side - root.pad - 14px - self.preferred-width) / 2;
        y: root.pad + root.cover + 12px + 22px + 8px;
        width: self.preferred-width;
        height: 36px;
        spacing: 10px;
        MediaButton { width: 36px; height: 36px; border-radius: 18px; glyph: Glyphs.prev; glyph-size: 13px; clicked => { root.command("previous"); } }
        MediaButton { width: 36px; height: 36px; border-radius: 18px; glyph: root.music.playing ? Glyphs.pause : Glyphs.play; glyph-size: 16px; ring: true; clicked => { root.command("play-pause"); } }
        MediaButton { width: 36px; height: 36px; border-radius: 18px; glyph: Glyphs.next; glyph-size: 13px; clicked => { root.command("next"); } }
    }
    Rectangle { x: root.side; y: 16px; width: 1px; height: root.height - 32px; background: Mini.wash.with-alpha(min(1, 0.078 * Mini.wk)); }
    view := Rectangle {
        x: root.side + 1px;
        width: parent.width - root.side - 1px - 36px;
        height: parent.height;
        clip: true;
        list := VerticalLayout {
            property <length> sung-y;
            property <length> sung-h: 24px;
            x: 0;
            width: view.width;
            y: (view.height - self.sung-h) / 2 - self.sung-y;
            animate y { duration: 520ms; easing: cubic-bezier(0.25, 0.8, 0.3, 1); }
            for line[i] in root.music.lyrics : line-row := VerticalLayout {
                property <bool> now: i == max(0, root.music.lyric-center);
                property <bool> sung: i == root.music.lyric-index;
                // Where its middle is on the card: the card's edges fade.
                property <length> mid: list.y + self.y + self.height / 2;
                property <float> edge: clamp(min(self.mid, view.height - self.mid) / (view.height * 0.22), 0, 1);
                padding-left: 18px;
                padding-right: 18px;
                padding-top: 5px;
                padding-bottom: 5px;
                opacity: self.edge;
                // Romaji: the line's own reading (empty for a non-Japanese line).
                property <string> ro: line.romaji;
                Text {
                    text: line.text;
                    wrap: word-wrap;
                    font-size: 14.5px;
                    font-weight: 600;
                    color: i == root.music.lyric-index ? Mini.ink : Mini.wash.with-alpha(min(1, 0.361 * Mini.wk));
                    animate color { duration: 300ms; }
                }
                if line-row.ro != "" && root.romaji : Text {
                    text: line-row.ro;
                    wrap: word-wrap;
                    font-size: 10.5px;
                    color: i == root.music.lyric-index ? Mini.wash.with-alpha(min(1, 0.8 * Mini.wk)) : Mini.wash.with-alpha(min(1, 0.29 * Mini.wk));
                }
                init => { if self.now { list.sung-y = self.y; list.sung-h = self.height; } }
                changed now => { if self.now { list.sung-y = self.y; list.sung-h = self.height; } }
                changed y => { if self.now { list.sung-y = self.y; } }
                changed height => { if self.now { list.sung-h = self.height; } }
            }
        }
    }
    HorizontalLayout {
        x: parent.width - 8px - self.preferred-width;
        y: 8px;
        width: self.preferred-width;
        height: 24px;
        spacing: 4px;
        if root.japanese : PageToggle { label: "あ"; on: root.furigana; clicked => { root.furigana = !root.furigana; } }
        if root.japanese : PageToggle { label: "Ro"; on: root.romaji; clicked => { root.romaji = !root.romaji; } }
        PageToggle { label: root.held ? Glyphs.pinned : Glyphs.pin; glyph: true; on: root.held; clicked => { root.command("hold"); } }
    }
}

// Accounts: one column per app (its icon and name, then its accounts as
// chips stacked: a round initial and the name). The one in use is solid
// white; a click on another asks NotchDeck to switch.
component AccountChip inherits Rectangle {
    in property <AccountRow> account;
    in property <bool> pending;
    callback clicked();
    height: 34px;
    border-radius: 17px;
    background: root.account.active ? Mini.wash.with-alpha(min(1, 0.949 * Mini.wk)) : area.has-hover ? Mini.wash.with-alpha(min(1, 0.227 * Mini.wk)) : root.pending ? Mini.wash.with-alpha(min(1, 0.271 * Mini.wk)) : Mini.wash.with-alpha(min(1, 0.122 * Mini.wk));
    animate background { duration: 150ms; }
    HorizontalLayout {
        x: 5px;
        width: parent.width - 5px - 12px;
        spacing: 8px;
        Rectangle {
            width: 24px;
            height: 24px;
            y: (parent.height - self.height) / 2;
            border-radius: 12px;
            background: root.account.active ? Mini.base : Mini.wash.with-alpha(min(1, 0.2 * Mini.wk));
            Text { width: 100%; height: 100%; horizontal-alignment: center; vertical-alignment: center; text: root.account.initial; color: Mini.ink; font-size: 11.5px; font-weight: 700; }
        }
        Text {
            horizontal-stretch: 1;
            text: root.pending && !root.account.active ? root.account.name + "  ..." : root.account.name;
            color: root.account.active ? Mini.base : Mini.ink;
            font-size: 13px;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
        }
        if root.account.plan != "" : Rectangle {
            y: (parent.height - self.height) / 2;
            height: 18px;
            width: badge.preferred-width + 14px;
            border-radius: 9px;
            background: root.account.active ? Mini.base.with-alpha(0.12) : Mini.wash.with-alpha(0.16);
            badge := Text { text: root.account.plan; color: root.account.active ? Mini.base : Mini.ink; font-size: 10.5px; font-weight: 700; vertical-alignment: center; horizontal-alignment: center; }
        }
    }
    area := TouchArea { enabled: !root.account.active; mouse-cursor: root.account.active ? default : pointer; clicked => { root.clicked(); } }
}

// A limit under a chip (USAGE_ROW_H in main.rs): its name and when it
// resets, then a thin bar and how much is used. Amber past 75 %, red past 90 %.
component UsageLine inherits Rectangle {
    in property <UsageRow> usage;
    height: 28px;
    property <color> fill: root.usage.used >= 0.9 ? #ff453a : root.usage.used >= 0.75 ? #ff9f0a : Mini.ink;
    Text { x: 4px; y: 0; width: parent.width - 4px - 2px - resets.preferred-width - 6px; height: 13px; text: root.usage.label; color: Mini.text-3; font-size: 11px; font-weight: 600; overflow: elide; vertical-alignment: center; }
    resets := Text { x: parent.width - self.width - 2px; y: 0; height: 13px; text: root.usage.resets; color: Mini.faint; font-size: 10.5px; vertical-alignment: center; }
    Rectangle {
        x: 4px;
        y: 19px;
        width: parent.width - 4px - 6px - used.width - 2px;
        height: 4px;
        border-radius: 2px;
        background: Mini.wash.with-alpha(0.14);
        Rectangle {
            x: 0;
            width: root.usage.used <= 0 ? 0 : max(4px, parent.width * min(1, root.usage.used));
            height: 4px;
            border-radius: 2px;
            background: root.fill;
        }
    }
    used := Text { x: parent.width - self.width - 2px; y: 15px; width: 60px; horizontal-alignment: right; height: 13px; text: root.usage.used-text; color: Mini.text-2; font-size: 10.5px; font-weight: 600; vertical-alignment: center; }
}

// An account: its chip, then its limits and a note (heights in main.rs).
component AccountBlock inherits VerticalLayout {
    in property <AccountRow> account;
    in property <bool> pending;
    callback clicked();
    spacing: 5px;
    AccountChip { account: root.account; pending: root.pending; clicked => { root.clicked(); } }
    for w in root.account.windows : UsageLine { usage: w; }
    if root.account.note != "" : Text {
        height: root.account.note-lines * 13px;
        x: 4px;
        text: root.account.note;
        color: Mini.faint;
        font-size: 10.5px;
        vertical-alignment: center;
        overflow: elide;
    }
}

component AccountsPage inherits Rectangle {
    in property <[AccountGroup]> groups;
    in property <string> pending;
    in property <string> note;
    callback clicked(string);
    property <length> gap: 10px;
    property <length> col-w: (root.width - (root.groups.length - 1) * self.gap) / max(1, root.groups.length);
    if root.groups.length == 0 : Text {
        width: parent.width;
        height: parent.height;
        text: root.note == "" ? "No accounts in NotchDeck yet" : root.note;
        color: Mini.text-3;
        font-size: 13px;
        horizontal-alignment: center;
        vertical-alignment: center;
        wrap: word-wrap;
    }
    for g[i] in root.groups : Rectangle {
        x: i * (root.col-w + root.gap);
        width: root.col-w;
        height: parent.height;
        border-radius: 14px;
        background: Mini.wash.with-alpha(min(1, 0.039 * Mini.wk));
        VerticalLayout {
            padding: 8px;
            spacing: 8px;
            alignment: start;
            HorizontalLayout {
                height: 20px;
                padding-left: 4px;
                spacing: 7px;
                alignment: start;
                Glyph { width: 13px; text: Glyphs.service(g.title); font-size: 12px; color: Mini.label; horizontal-alignment: left; }
                Text { text: g.title; color: Mini.label; font-size: 12px; font-weight: 600; vertical-alignment: center; overflow: elide; }
            }
            for a in g.accounts : AccountBlock { account: a; pending: root.pending == a.id; clicked => { root.clicked(a.id); } }
        }
    }
}

// ── The island ───────────────────────────────────────────────────────────────

// Prayer: the next prayer and the time left on the left; on the right the
// day's marks and the five prayers evenly along a line from Subuh to Isya,
// the part already gone filled, now marked above it, the next one a green ring.
component PrayerPage inherits Rectangle {
    in property <PrayerView> p;
    out property <color> green: Mini.good;
    // The timeline's width is PRAYER_TRACK_W in main.rs (the dots' x come from there).
    property <length> col-x: 232px;
    property <length> col-w: 420px;
    property <length> track-y: 66px;
    // A quiet card behind the countdown, the line beside it.
    Rectangle {
        x: 0;
        y: 0;
        width: root.col-x - 16px;
        height: root.height;
        border-radius: 14px;
        background: Mini.wash.with-alpha(min(1, 0.039 * Mini.wk));
    }

    VerticalLayout {
        x: 16px;
        y: 0;
        width: root.col-x - 16px - 32px;
        height: root.height;
        alignment: center;
        spacing: 0px;
        Text { text: root.p.next-name; color: root.green; font-size: 14px; font-weight: 700; overflow: elide; }
        Text { text: root.p.countdown; color: Mini.ink; font-size: 32px; font-weight: 700; }
        Text { text: root.p.when; color: Mini.text-2; font-size: 12px; overflow: elide; }
        HorizontalLayout {
            padding-top: 4px;
            spacing: 4px;
            Glyph { width: 11px; text: Glyphs.place; font-size: 10px; color: Mini.label; }
            Text { text: root.p.place; color: Mini.label; font-size: 11px; overflow: elide; horizontal-stretch: 1; }
        }
    }

    Rectangle {
        x: root.col-x;
        y: 0;
        width: root.col-w;
        height: root.height;
        Text {
            x: 0;
            y: 10px;
            width: parent.width;
            height: 15px;
            text: root.p.info;
            color: Mini.label;
            font-size: 11px;
            horizontal-alignment: center;
            overflow: elide;
        }
        // Now, above the line.
        Text {
            x: clamp(root.p.now-x - self.width / 2, 0px, parent.width - self.width);
            y: root.track-y - 8px - 15px;
            width: self.preferred-width;
            height: 15px;
            text: root.p.now-text;
            color: Mini.ink;
            font-size: 11px;
            font-weight: 600;
        }
        // The line, filled as far as now.
        Rectangle {
            x: root.p.track-from;
            y: root.track-y - 1.5px;
            width: root.p.track-to - root.p.track-from;
            height: 3px;
            border-radius: 1.5px;
            background: Mini.wash.with-alpha(min(1, 0.149 * Mini.wk));
        }
        Rectangle {
            x: root.p.track-from;
            y: root.track-y - 1.5px;
            width: max(3px, root.p.now-x - root.p.track-from);
            height: 3px;
            border-radius: 1.5px;
            background: root.green.with-alpha(0.75);
        }
        for m in root.p.marks : Rectangle {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            Rectangle {
                property <length> size: m.next ? 13px : 9px;
                x: m.dot-x - self.size / 2;
                y: root.track-y - self.size / 2;
                width: self.size;
                height: self.size;
                border-radius: self.size / 2;
                background: m.next ? Mini.base : m.past ? root.green : Mini.mute;
                border-width: m.next ? 2px : 0px;
                border-color: root.green;
            }
            Text {
                x: m.dot-x - self.width / 2;
                y: root.track-y + 11px;
                width: 56px;
                height: 15px;
                text: m.name;
                color: m.next ? root.green : m.past ? Mini.label : Mini.text-2;
                font-size: 11.5px;
                font-weight: m.next ? 700 : 600;
                horizontal-alignment: center;
            }
            Text {
                x: m.dot-x - self.width / 2;
                y: root.track-y + 27px;
                width: 56px;
                height: 15px;
                text: m.time;
                color: m.next ? root.green : Mini.label;
                font-size: 11px;
                font-weight: m.next ? 700 : 400;
                horizontal-alignment: center;
            }
        }
        // Now's mark across the line.
        Rectangle {
            x: root.p.now-x - 0.75px;
            y: root.track-y - 6px;
            width: 1.5px;
            height: 12px;
            border-radius: 0.75px;
            background: Mini.ink;
        }
    }
}

export component Island inherits Window {
    default-font-family: "Allo";
    title: "Kanmuri";
    no-frame: true;
    always-on-top: true;
    background: transparent;

    in property <bool> has-front;
    // The song keeps the capsule while Claude Code only runs a tool.
    in property <bool> song-over;
    // The front is a notification with a message: the capsule becomes a small card.
    in property <bool> notice;
    // That notice is the music's (a new song, play, pause): the song's card.
    in property <bool> music-notice;
    in property <Item> front;
    in property <int> waiting;
    in property <[Item]> others;
    in property <string> clock;
    in property <string> date;
    // Next to the idle time (Settings > General): "wifi" | "ethernet" |
    // "wifi-off" | "" (off), the battery's "87%" ("" off or no battery).
    in property <string> status-net;
    in property <string> status-battery;
    in property <float> status-battery-level;
    in property <bool> status-charging;
    // What sits left and right of the idle time: "" | "date" | "network" | "battery".
    in property <string> idle-left;
    in property <string> idle-right;
    in property <[TabInfo]> tabs;
    in property <string> active-tab: "notifications";
    in property <Music> music;
    // The player's volume, 0..1 (-1: not known; the card then shows the song's progress).
    in property <float> volume: -1;
    // The lyrics are Japanese: the lyrics card offers furigana and romaji.
    in property <bool> lyrics-japanese;
    // Romaji of the line on the capsule (shown under it), when the lyrics have it.
    in property <string> capsule-romaji;
    in property <[NotifRow]> notifications;
    in property <[AskRow]> asks;
    in property <FocusView> pomodoro;
    in property <WaterView> water;
    in property <PrayerView> prayer;
    in property <[TaskRow]> tasks;
    in property <[DoneRow]> todo-log;
    // The to-do page shows its log (set at start for snapshots of it).
    in-out property <bool> todo-show-log;
    in property <[ShelfRow]> shelf;
    in property <[AccountGroup]> account-groups;
    in property <string> account-pending;
    in property <string> account-note;
    callback account-clicked(string);
    in property <bool> drop-hover;
    // "hidden", "compact", "expanded".
    in property <string> mode: "compact";
    in property <string> mascot-mood: "idle";
    in property <bool> held;
    // Line: the capsule stays, showing the line being sung (capsule-line;
    // empty between lines: the song then runs in the capsule).
    in property <bool> line-held;
    in property <string> capsule-line;
    // A long one (unused: a long line is drawn smaller instead).
    in property <bool> capsule-long;
    // Something else up front while Line holds: shown under the lyric.
    in property <bool> line-notice;
    // Flipped by Rust to have the island drawn again in full (see the body).
    in property <bool> repaint;
    // Do not disturb: the island stays down for notifications (calls excepted).
    in property <bool> dnd;
    callback dnd-clicked();
    // A YouTube video docked under the island ("Watch in island"), kept
    // shown (held) or following the island; its title.
    in property <bool> watching;
    in property <bool> watch-held;
    in property <string> watch-title;
    callback watch-clicked();
    callback watch-back();
    in property <int> mascot-dx;
    in property <int> mascot-dy;
    in property <bool> mascot-left;
    in property <bool> mascot-on: true;
    // The user's picture behind the island, already cut to its size and corners.
    in property <bool> has-bg;
    in property <image> bg;
    // The island's size for the mode (Rust): it springs there.
    in property <length> target-w: 180px;
    in property <length> target-h: 45px;

    callback shelf-open(int);
    callback shelf-copy(int);
    callback shelf-remove(int);
    callback shelf-clear();
    // "start", "pause", "skip", "reset".
    callback focus-command(string);
    // "drink", "undo".
    callback water-command(string);
    callback todo-add(string);
    callback todo-toggle(int);
    callback todo-remove(int);
    callback todo-move(int, int);
    callback todo-clear-done();
    in property <int> todo-open;
    callback mascot-clicked();
    callback hover-changed(bool);
    callback front-clicked();
    callback notif-clicked(int);
    callback notif-clear();
    callback action-clicked(string);
    // A question answered from its row on the Notifications page: its id, "allow" / "deny".
    callback ask-answered(string, string);
    callback dismiss();
    callback tab-clicked(string);
    callback open-settings();
    // "play-pause", "next", "previous", "line-hold", "hold".
    callback music-command(string);
    callback lyrics-nudge(float);

    property <bool> hidden: mode == "hidden";
    property <bool> compact: mode == "compact";
    property <bool> expanded: mode == "expanded";
    // What the capsule shows.
    property <bool> show-line: root.compact && root.line-held;
    property <bool> show-media: root.compact && !root.line-held && root.notice && root.music-notice;
    property <bool> show-notif: root.compact && !root.line-held && root.notice && !root.music-notice;
    property <bool> show-ask: root.compact && !root.line-held && !root.notice && root.has-front && root.front.kind == "ask";
    property <bool> show-song: root.compact && !root.line-held && !root.notice && root.has-front && (root.front.kind == "ambient" || root.song-over) && root.music.has-session;
    property <bool> show-one: root.compact && !root.line-held && !root.notice && !root.show-ask && !root.show-song;
    // Springs: the size, and the radius.
    property <length> island-w: target-w;
    property <length> island-h: target-h;
    animate island-w, island-h { duration: Ice.morph; easing: cubic-bezier(0.22, 1.18, 0.36, 1); }
    property <length> island-r: root.hidden ? 2px : root.expanded || root.show-media ? 24px : root.show-line && root.line-notice ? 22px : self.island-h / 2;
    animate island-r { duration: Ice.morph; easing: ease-out; }
    property <length> ix: (root.width - self.island-w) / 2;
    property <length> body-y: root.hidden ? 2px : Ice.top;

    // The song's colour: the cover's, a light grey for a grey cover, green without one.
    property <color> song-accent: root.music.has-accent ? root.music.accent : root.music.has-art ? (Mini.light ? #5a5a62 : #c8c8d2) : Mini.good;
    property <bool> song-lit: root.music.has-session && (
        (root.expanded && (root.active-tab == "music" || root.active-tab == "lyrics"))
        || root.show-line || root.show-song || root.show-media);
    // The island takes the colour of what it shows: the song's, the app's, else a neutral grey.
    property <color> tint: root.song-lit ? root.song-accent
        : (root.show-notif || root.show-ask || (root.show-one && root.has-front)) ? root.front.accent
        : Mini.neutral;
    animate tint { duration: 650ms; easing: ease-in-out; }
    // The pointer is on the island (it opens a moment later).
    property <bool> pointer-on;
    // Something asks for attention: a notification, a question, a song's
    // notice, any activity but the song itself.
    property <bool> alerting: root.show-notif || root.show-ask || root.show-media
        || (root.has-front && root.front.kind != "ambient");
    // Opacity when closed (Settings → Appearance): only the quiet capsule.
    property <float> body-alpha: Mini.solid * (root.compact && !root.pointer-on && !root.alerting ? Mini.closed : 1);
    animate body-alpha { duration: 260ms; easing: ease-in-out; }

    // Hidden: a wider strip than the handle, so it is easy to point at.
    if hidden : TouchArea {
        x: (root.width - 200px) / 2;
        y: 0;
        width: 200px;
        height: 18px;
        changed has-hover => { root.hover-changed(self.has-hover); }
    }

    // The handle above the open list (the hidden island is the handle itself).
    if root.expanded : Rectangle {
        x: (root.width - 64px) / 2;
        y: 2px;
        width: 64px;
        height: 4px;
        border-radius: 2px;
        background: Mini.handle;
    }

    // A faint glow in the song's colour while it plays (the window keeps 6 px for it).
    Rectangle {
        x: root.ix - 6px;
        y: root.body-y - 6px;
        width: root.island-w + 12px;
        height: root.island-h + 12px;
        border-radius: root.island-r + 6px;
        background: root.song-accent.with-alpha(root.song-lit && root.music.playing && !root.hidden ? 0.035 : 0);
    }
    Rectangle {
        x: root.ix - 3px;
        y: root.body-y - 3px;
        width: root.island-w + 6px;
        height: root.island-h + 6px;
        border-radius: root.island-r + 3px;
        background: root.song-accent.with-alpha(root.song-lit && root.music.playing && !root.hidden ? 0.07 : 0);
    }
    // The body: one shape with its own 1 px edge (stacked rounded layers
    // left halos at the edges with the software renderer).
    Rectangle {
        x: root.ix;
        y: root.body-y;
        width: root.island-w;
        height: root.island-h;
        border-radius: root.island-r;
        border-width: root.hidden ? 0px : 1px;
        border-color: Mini.edge;
        // `repaint` flips the alpha by 1/255 (invisible): the whole island
        // counts as changed and is drawn again. Without it the software
        // renderer kept showing the old lyric in Line's capsule.
        background: root.hidden ? Mini.handle.with-alpha(root.repaint ? 1 : 0.996)
            : Mini.base.with-alpha(root.repaint ? root.body-alpha : root.body-alpha - 0.004);
        clip: true;

        // The colour from the left edge, gone by 45 % of the width.
        Fade {
            width: parent.width;
            height: parent.height;
            visible: !root.hidden;
            r: root.island-r;
            tint: root.tint;
            strength: 0.30;
            span: 0.45;
        }

        // Shown once the spring has settled at the size it was cut for.
        if root.has-bg : Image {
            x: 1px;
            y: 1px;
            width: parent.width - 2px;
            height: parent.height - 2px;
            source: root.bg;
            image-fit: fill;
            // Stays while the island springs (stretched for that moment), gone only when hidden.
            opacity: !root.hidden ? 1 : 0;
            animate opacity { duration: 240ms; }
        }

        // Everything inside the hover area, so pointing at a button still
        // counts as being over the island.
        TouchArea {
            changed has-hover => {
                root.pointer-on = self.has-hover;
                root.hover-changed(self.has-hover);
            }

            // Compact, a notification (Mini Island's popup): the app's round
            // icon, title and message, the app's name in its colour and the time.
            Rectangle {
                opacity: root.show-notif ? 1 : 0;
                animate opacity { duration: Ice.fade; }
                visible: self.opacity > 0.01;
                AppIcon { x: 12px; y: (parent.height - self.height) / 2; accent: root.front.accent; initial: root.front.initial; logo: root.front.logo; has-logo: root.front.has-logo; }
                VerticalLayout {
                    x: 12px + 34px + 10px;
                    width: parent.width - self.x - 8px - notif-right.width - 22px;
                    alignment: center;
                    spacing: 1px;
                    Text { text: root.front.title; color: Mini.ink; font-size: 13px; font-weight: 600; overflow: elide; }
                    if root.front.body != "" : Text { text: root.front.body; color: Mini.text-2; font-size: 12px; overflow: elide; }
                }
                notif-right := VerticalLayout {
                    x: parent.width - 22px - self.width;
                    width: min(80px, max(app-name.preferred-width, notif-time.preferred-width));
                    alignment: center;
                    spacing: 1px;
                    app-name := Text { text: root.front.source; color: Paint.readable(root.front.accent); font-size: 10.5px; font-weight: 600; horizontal-alignment: right; overflow: elide; }
                    notif-time := Text { text: root.clock; color: Mini.label; font-size: 10.5px; horizontal-alignment: right; }
                }
                TouchArea { clicked => { root.front-clicked(); } }
            }

            // Compact, a question: the popup with its answers on the right.
            Rectangle {
                opacity: root.show-ask ? 1 : 0;
                animate opacity { duration: Ice.fade; }
                visible: self.opacity > 0.01;
                AppIcon { x: 12px; y: (parent.height - self.height) / 2; accent: root.front.accent; initial: root.front.initial; logo: root.front.logo; has-logo: root.front.has-logo; }
                VerticalLayout {
                    x: 12px + 34px + 10px;
                    width: parent.width - self.x - 8px - ask-actions.preferred-width - 16px;
                    alignment: center;
                    spacing: 1px;
                    Text { text: root.front.title; color: Mini.ink; font-size: 13px; font-weight: 600; overflow: elide; }
                    if root.front.body != "" : Text { text: root.front.body; color: Mini.text-2; font-size: 12px; overflow: elide; }
                }
                ask-actions := HorizontalLayout {
                    x: parent.width - 16px - self.preferred-width;
                    y: (parent.height - 24px) / 2;
                    width: self.preferred-width;
                    height: 24px;
                    spacing: 6px;
                    for a in root.front.actions : ActionPill { label: a.label; clicked => { root.action-clicked(a.id); } }
                }
            }

            // Compact, the music's notice (a new song, play, pause): Mini Island's song popup.
            Rectangle {
                opacity: root.show-media ? 1 : 0;
                animate opacity { duration: Ice.fade; }
                visible: self.opacity > 0.01;
                MusicCard {
                    y: -4px + 1px;
                    width: parent.width;
                    card: false;
                    music: root.music;
                    accent: root.song-accent;
                    volume: root.volume;
                    live: root.show-media;
                    line-held: root.line-held;
                    command(c) => { root.music-command(c); }
                }
            }

            // Compact, the song (Mini Island's small pill): the cover, the
            // line being sung (Line) or the song running by, the bars. A
            // notice while Line holds shows underneath, so the lyric is never covered.
            Rectangle {
                opacity: root.show-song || root.show-line ? 1 : 0;
                animate opacity { duration: Ice.fade; }
                visible: self.opacity > 0.01;
                property <length> pill-h: root.show-line && root.line-notice ? self.height - (root.front.body != "" ? 54px : 30px) : self.height;
                Cover {
                    x: 10px;
                    y: (parent.pill-h - self.height) / 2;
                    size: 30px;
                    glyph-size: 15px;
                    border-radius: 8px;
                    music: root.music;
                    accent: root.song-accent;
                }
                Equalizer {
                    x: parent.width - 16px - self.width;
                    y: (parent.pill-h - self.height) / 2;
                    bar-w: 3px * 0.95;
                    bar-h: 12px * 0.95;
                    playing: root.music.playing;
                    tint: Paint.readable(root.song-accent);
                }
                // Between the cover and the bars.
                lyric-box := Rectangle {
                    x: 10px + 30px + 12px;
                    width: parent.width - self.x - 12px - 16px - 3 * 5px * 0.95;
                    height: parent.pill-h;
                    property <bool> lyric: root.show-line && root.capsule-line != "";
                    if !lyric-box.lyric : Marquee {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        width: min(parent.width, 156px);
                        height: 15px + 9px;
                        music: root.music;
                        accent: root.song-accent;
                        live: root.show-song || root.show-line;
                    }
                    // The line: the song's colour lifted toward white, made
                    // smaller when it is too long for the widest capsule.
                    line-probe := Text { visible: false; text: root.capsule-line; font-size: 11.5px * Mini.k; font-weight: 600; }
                    ro-probe := Text { visible: false; text: root.capsule-romaji; font-size: 8.5px * Mini.k; }
                    if lyric-box.lyric : VerticalLayout {
                        alignment: center;
                        spacing: 1px;
                        Text {
                            text: root.capsule-line;
                            color: Mini.ink;
                            font-size: 11.5px * Mini.k * min(1, lyric-box.width / max(1px, line-probe.preferred-width));
                            font-weight: 600;
                            horizontal-alignment: center;
                        }
                        if root.capsule-romaji != "" : Text {
                            text: root.capsule-romaji;
                            color: Mini.text-2;
                            font-size: 8.5px * Mini.k * min(1, lyric-box.width / max(1px, ro-probe.preferred-width));
                            horizontal-alignment: center;
                        }
                    }
                }
                if root.show-line && root.line-notice : Rectangle {
                    y: parent.pill-h;
                    height: parent.height - parent.pill-h;
                    Rectangle { x: 14px; width: parent.width - 28px; y: 0; height: 1px; background: Mini.wash.with-alpha(min(1, 0.122 * Mini.wk)); }
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 16px;
                        spacing: 10px;
                        if root.front.icon != "" : SysIcon { name: root.front.icon; y: (parent.height - self.height) / 2; }
                        if root.front.icon == "" : AppIcon { size: 26px; accent: root.front.accent; initial: root.front.initial; logo: root.front.logo; has-logo: root.front.has-logo; y: (parent.height - self.height) / 2; }
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            Text { text: root.front.title; color: Mini.ink; font-size: 13px; font-weight: 600; overflow: elide; }
                            if root.front.body != "" : Text { text: root.front.body; color: Mini.text-2; font-size: 12px; overflow: elide; }
                        }
                        if root.front.has-progress : Bar { width: 70px; value: root.front.progress; tint: Paint.readable(root.front.accent); y: (parent.height - self.height) / 2; }
                        if root.waiting > 0 : Text { text: "+" + root.waiting; color: Mini.label; font-size: 11px; font-weight: 600; vertical-alignment: center; }
                    }
                }
            }

            // Compact, anything else on one line (a system notice, a
            // progress, a status), or the time when nothing goes on.
            HorizontalLayout {
                opacity: root.show-one ? 1 : 0;
                animate opacity { duration: Ice.fade; }
                visible: self.opacity > 0.01;
                padding-left: 14px;
                padding-right: 16px;
                spacing: 10px;
                alignment: center;
                if root.has-front && root.front.icon != "" : SysIcon { name: root.front.icon; y: (parent.height - self.height) / 2; }
                if root.has-front && root.front.icon == "" : AppIcon { size: 26px; accent: root.front.accent; initial: root.front.initial; logo: root.front.logo; has-logo: root.front.has-logo; y: (parent.height - self.height) / 2; }
                if !root.has-front && root.idle-left != "" : IdleSlot { kind: root.idle-left; date: root.date; net: root.status-net; battery: root.status-battery; level: root.status-battery-level; charging: root.status-charging; }
                Text {
                    text: root.has-front ? root.front.title : root.clock;
                    color: Mini.ink;
                    font-size: root.has-front ? 13px : 16px;
                    font-weight: root.has-front ? 600 : 700;
                    vertical-alignment: center;
                    overflow: elide;
                }
                if root.has-front && root.front.has-progress : Bar { width: 70px; value: root.front.progress; tint: Paint.readable(root.front.accent); y: (parent.height - self.height) / 2; }
                if !root.has-front && root.idle-right != "" : IdleSlot { kind: root.idle-right; date: root.date; net: root.status-net; battery: root.status-battery; level: root.status-battery-level; charging: root.status-charging; }
                if root.waiting > 0 : Text { text: "+" + root.waiting; color: Mini.label; font-size: 11px; font-weight: 600; vertical-alignment: center; }
                if root.watching : Glyph { width: 14px; text: Glyphs.video; font-size: 11px; color: Mini.label; }
                if root.dnd : Glyph { width: 14px; text: Glyphs.moon; font-size: 11px; color: Mini.label; }
            }

            // Open (laid out like Poni's): one top bar (the tabs, the time,
            // the quick buttons on the right), the page across the full width
            // underneath, no footer.
            Rectangle {
                opacity: root.expanded ? 1 : 0;
                animate opacity { duration: Ice.fade; easing: ease-out; }
                visible: self.opacity > 0.01;
                property <length> inner-x: 1px + 14px;
                property <length> inner-w: self.width - 2 * self.inner-x;

                // The tab track: one tab per page, the open one a lighter pill with its name.
                tab-track := Rectangle {
                    x: parent.inner-x;
                    y: 1px + 12px;
                    width: tab-row.preferred-width + 6px;
                    height: 36px;
                    border-radius: 13px;
                    background: Mini.wash.with-alpha(min(1, 0.118 * Mini.wk));
                    tab-row := HorizontalLayout {
                        x: 3px;
                        width: self.preferred-width;
                        y: 3px;
                        height: 30px;
                        for t in root.tabs : Rectangle {
                            property <bool> on: root.active-tab == t.id;
                            width: self.on ? tab-label.preferred-width + 10px + 14px + 7px + 12px : 34px;
                            height: 30px;
                            border-radius: 10px;
                            background: self.on ? (Mini.light ? #ffffff : Mini.wash.with-alpha(0.227)) : tab-area.has-hover ? Mini.wash.with-alpha(min(1, 0.102 * Mini.wk)) : transparent;
                            animate background { duration: 150ms; }
                            if t.id == "prayer" : Path {
                                x: parent.on ? 10px : (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                width: 15px;
                                height: 15px;
                                viewbox-width: 24;
                                viewbox-height: 24;
                                stroke-width: 1.6px;
                                stroke: parent.on || tab-area.has-hover ? Mini.ink : Mini.text-3;
                                commands: Glyphs.mosque;
                            }
                            if t.id != "prayer" : Glyph {
                                x: parent.on ? 10px : (parent.width - self.width) / 2;
                                width: 14px;
                                text: Glyphs.tab(t.id);
                                font-size: 14px;
                                color: parent.on || tab-area.has-hover ? Mini.ink : Mini.text-3;
                            }
                            tab-label := Text {
                                x: 10px + 14px + 7px;
                                width: self.preferred-width;
                                height: 100%;
                                visible: parent.on;
                                text: t.label;
                                color: Mini.ink;
                                font-size: 13px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                            tab-area := TouchArea { enabled: !parent.on; mouse-cursor: pointer; clicked => { root.tab-clicked(t.id); } }
                        }
                    }
                }
                // The time, right after the tabs.
                Text {
                    x: tab-track.x + tab-track.width + 16px;
                    width: self.preferred-width;
                    y: 1px + 12px;
                    height: 36px;
                    text: root.clock;
                    color: Mini.ink;
                    font-size: 18px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                // The quick buttons: a docked video (while one is), Do not
                // disturb, the notifications with their count, the gear.
                HorizontalLayout {
                    x: parent.inner-x + parent.inner-w - self.preferred-width;
                    width: self.preferred-width;
                    y: 1px + 12px + 3px;
                    height: 30px;
                    spacing: 8px;
                    if root.watching : QuickButton {
                        glyph: Glyphs.video;
                        on: root.watch-held;
                        clicked => { root.watch-clicked(); }
                        right-clicked => { root.watch-back(); }
                    }
                    QuickButton { glyph: Glyphs.moon; on: root.dnd; clicked => { root.dnd-clicked(); } }
                    QuickButton {
                        glyph: Glyphs.bell;
                        on: root.active-tab == "notifications";
                        badge: root.notifications.length + root.asks.length;
                        clicked => { root.tab-clicked("notifications"); }
                    }
                    QuickButton { glyph: Glyphs.gear; clicked => { root.open-settings(); } }
                }

                // The page.
                Rectangle {
                    x: parent.inner-x;
                    y: 1px + 12px + 36px + 10px;
                    width: parent.inner-w;
                    height: parent.height - self.y - 14px - 1px;
                    Page {
                        shown: root.active-tab == "notifications";
                        NotifPage {
                            items: root.notifications;
                            asks: root.asks;
                            clicked(i) => { root.notif-clicked(i); }
                            clear => { root.notif-clear(); }
                            answered(id, a) => { root.ask-answered(id, a); }
                        }
                    }
                    Page {
                        shown: root.active-tab == "music" || root.active-tab == "lyrics";
                        if root.music.lyrics.length > 0 : LyricsPage {
                            width: parent.width;
                            height: parent.height;
                            music: root.music;
                            accent: root.song-accent;
                            held: root.held;
                            japanese: root.lyrics-japanese;
                            live: root.expanded && (root.active-tab == "music" || root.active-tab == "lyrics");
                            command(c) => { root.music-command(c); }
                        }
                        if root.music.lyrics.length == 0 : MusicWide {
                            width: parent.width;
                            height: parent.height;
                            music: root.music;
                            accent: root.song-accent;
                            volume: root.volume;
                            live: root.expanded && root.active-tab == "music";
                            line-held: root.line-held;
                            command(c) => { root.music-command(c); }
                        }
                    }
                    Page {
                        shown: root.active-tab == "prayer";
                        PrayerPage { width: parent.width; height: parent.height; p: root.prayer; }
                    }
                    Page {
                        shown: root.active-tab == "accounts";
                        AccountsPage {
                            width: parent.width;
                            height: parent.height;
                            groups: root.account-groups;
                            pending: root.account-pending;
                            note: root.account-note;
                            clicked(id) => { root.account-clicked(id); }
                        }
                    }
                }

            }
        }
    }
}

export { SettingsWindow, Tray, ModuleRow, ConfirmWindow, SettingsView, AppSwitch } from "settings.slint";
