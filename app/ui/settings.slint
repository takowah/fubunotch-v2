// The Settings window and the tray icon. Every change goes to Rust at once
// and is saved there (settings.json), and the island follows right away;
// nothing here keeps state of its own beyond the page shown. The layout: a
// sidebar of pages and cards of rows (title, hint, control), and the theme's
// pixel mascot living on top of it all (Rust walks it around).

import { Button, Palette } from "std-widgets.slint";
import { Ice } from "theme.slint";
import { Sprites } from "sprites.slint";

export struct ModuleRow {
    id: string,
    name: string,
    enabled: bool,
}

export struct AppSwitch {
    name: string,
    on: bool,
}

export struct SettingsView {
    modules: [ModuleRow],
    lyrics: bool,
    lyrics-youtube: bool,
    romaji: bool,
    notif-popups: bool,
    notif-list: [AppSwitch],
    sys-volume: bool,
    sys-caps: bool,
    sys-layout: bool,
    sys-charger: bool,
    sys-network: bool,
    sys-audio: bool,
    autostart: bool,
    mascot: bool,
    popups: bool,
    hide-after: int,
    theme: string,
    has-background: bool,
    background-name: string,
    background-preview: image,
    background-dim: int,
    water-reminders: bool,
    water-goal: int,
    water-glass: int,
    water-every: int,
    // Minutes after midnight.
    water-from: int,
    water-until: int,
    focus-min: int,
    short-min: int,
    long-min: int,
    rounds: int,
    data-folder: string,
    claude-status: string,
    claude-installed: bool,
}

// ── Controls ─────────────────────────────────────────────────────────────────

component Toggle inherits Rectangle {
    in property <bool> on;
    in property <bool> enabled: true;
    callback toggled(bool);
    width: 40px;
    height: 22px;
    border-radius: 11px;
    background: !enabled ? Ice.ink.with-alpha(0.06) : on ? Ice.glow : Ice.ink.with-alpha(0.16);
    animate background { duration: 160ms; }
    Rectangle {
        width: 16px;
        height: 16px;
        y: 3px;
        x: root.on ? parent.width - self.width - 3px : 3px;
        animate x { duration: 180ms; easing: cubic-bezier(0.3, 1.4, 0.5, 1); }
        border-radius: 8px;
        background: root.on ? Ice.body-lo : Ice.ink;
    }
    TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.toggled(!root.on); }
    }
}

component SmallButton inherits Rectangle {
    in property <string> label;
    in property <bool> primary;
    in property <bool> enabled: true;
    callback clicked();
    width: t.preferred-width + 24px;
    height: 30px;
    border-radius: 9px;
    background: !enabled ? Ice.ink.with-alpha(0.04)
        : primary ? (a.has-hover ? Ice.frost : Ice.glow)
        : a.has-hover ? Ice.ink.with-alpha(0.14) : Ice.ink.with-alpha(0.08);
    animate background { duration: 140ms; }
    t := Text { text: root.label; color: root.primary ? Ice.body-lo : root.enabled ? Ice.ink : Ice.dim; font-size: 12px; font-weight: 600; }
    a := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// − value + : whole numbers, or a time of day (minutes) when `time` is set.
component Stepper inherits HorizontalLayout {
    in property <int> value;
    in property <int> step: 1;
    in property <int> minimum: 0;
    in property <int> maximum: 100;
    in property <string> unit;
    in property <bool> time;
    callback changed(int);
    spacing: 4px;
    SmallButton { label: "−"; enabled: root.value > root.minimum; clicked => { root.changed(max(root.minimum, root.value - root.step)); } }
    Rectangle {
        width: 74px;
        height: 30px;
        border-radius: 9px;
        background: Ice.body-lo;
        border-width: 1px;
        border-color: Ice.ink.with-alpha(0.08);
        Text {
            text: root.time
                ? (floor(root.value / 60) < 10 ? "0" : "") + floor(root.value / 60) + ":" + (mod(root.value, 60) < 10 ? "0" : "") + mod(root.value, 60)
                : root.value + (root.unit == "" ? "" : " " + root.unit);
            color: Ice.ink;
            font-size: 12.5px;
            font-weight: 600;
        }
    }
    SmallButton { label: "+"; enabled: root.value < root.maximum; clicked => { root.changed(min(root.maximum, root.value + root.step)); } }
}

// A row of a card: what it is on the left, its control on the right.
component SettingRow inherits Rectangle {
    in property <string> title;
    in property <string> hint;
    in property <bool> last;
    min-height: 56px;
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 16px;
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text { text: root.title; color: Ice.ink; font-size: 13px; font-weight: 600; wrap: word-wrap; }
            if root.hint != "" : Text { text: root.hint; color: Ice.dim; font-size: 11px; wrap: word-wrap; }
        }
        HorizontalLayout {
            alignment: end;
            spacing: 6px;
            VerticalLayout {
                alignment: center;
                @children
            }
        }
    }
    if !root.last : Rectangle {
        x: 16px;
        y: parent.height - 1px;
        width: parent.width - 32px;
        height: 1px;
        background: Ice.ink.with-alpha(0.07);
    }
}

component Card inherits Rectangle {
    in property <string> heading;
    border-radius: 14px;
    background: Ice.body;
    border-width: 1px;
    border-color: Ice.ink.with-alpha(0.08);
    VerticalLayout {
        @children
    }
}

component Heading inherits Text {
    color: Ice.dim;
    font-size: 10.5px;
    font-weight: 800;
    letter-spacing: 1.4px;
}

component NavItem inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    in property <color> accent;
    callback clicked();
    height: 34px;
    border-radius: 9px;
    background: active ? Ice.glow.with-alpha(0.16) : a.has-hover ? Ice.ink.with-alpha(0.06) : transparent;
    animate background { duration: 140ms; }
    if root.active : Rectangle {
        x: 0;
        width: 3px;
        height: 16px;
        border-radius: 1.5px;
        background: Ice.glow;
    }
    HorizontalLayout {
        padding-left: 14px;
        spacing: 10px;
        Rectangle {
            width: 8px;
            height: 8px;
            y: (parent.height - self.height) / 2;
            border-radius: 4px;
            background: root.active ? Ice.glow : root.accent;
        }
        Text { text: root.label; color: root.active ? Ice.ink : Ice.ink.with-alpha(0.75); font-size: 13px; font-weight: root.active ? 700 : 500; vertical-alignment: center; }
    }
    a := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// A theme to pick: the member's chibi, name and colours.
component ThemeCard inherits Rectangle {
    in property <string> id;
    in property <string> name;
    in property <bool> chosen;
    in property <color> c1;
    in property <color> c2;
    callback picked();
    width: 110px;
    height: 160px;
    border-radius: 14px;
    background: chosen ? Ice.glow.with-alpha(0.12) : a.has-hover ? Ice.ink.with-alpha(0.06) : Ice.body-lo;
    border-width: chosen ? 2px : 1px;
    border-color: chosen ? Ice.glow : Ice.ink.with-alpha(0.08);
    animate background { duration: 140ms; }
    VerticalLayout {
        padding: 10px;
        spacing: 6px;
        alignment: center;
        Image {
            width: 96px;
            height: 96px;
            x: (parent.width - self.width) / 2;
            image-rendering: pixelated;
            source: Sprites.pick(root.id, a.has-hover ? "happy" : "idle", false);
        }
        Text { text: root.name; color: Ice.ink; font-size: 12px; font-weight: 700; horizontal-alignment: center; }
        HorizontalLayout {
            alignment: center;
            spacing: 4px;
            Rectangle { width: 14px; height: 6px; border-radius: 3px; background: root.c1; }
            Rectangle { width: 14px; height: 6px; border-radius: 3px; background: root.c2; }
        }
    }
    a := TouchArea { mouse-cursor: pointer; clicked => { root.picked(); } }
}

// ── The window ───────────────────────────────────────────────────────────────

export component SettingsWindow inherits Window {
    title: "FubuNotch v2 · Settings";
    preferred-width: 900px;
    preferred-height: 600px;
    min-width: 760px;
    min-height: 520px;
    // Opaque: without it the software renderer leaves the window see-through.
    background: Ice.body-lo;

    in property <SettingsView> s;
    in-out property <string> page: "general";

    // The living mascot: where it is and what it does (Rust moves it).
    in property <length> pet-x: 40px;
    in property <length> pet-y: 400px;
    in property <string> pet-frame: "idle";
    in property <bool> pet-left;
    in property <string> pet-say;

    callback module-toggled(string, bool);
    callback module-moved(string, int);
    /// A switch, by key: "music.lyrics", "system.volume", "autostart"…
    callback flag-changed(string, bool);
    /// A number, by key: "water.goal_ml", "focus.rounds", "water.from" (minutes)…
    callback number-changed(string, int);
    callback apps-changed(string);
    callback notif-app-toggled(string, bool);
    callback theme-picked(string);
    /// "background.pick", "background.clear", "open-data-folder".
    callback action(string);
    callback claude-connect(bool);
    callback pet-clicked();

    HorizontalLayout {
        // ── Sidebar ──
        Rectangle {
            width: 232px;
            background: Ice.body;
            VerticalLayout {
                padding: 16px;
                padding-top: 18px;
                spacing: 4px;
                HorizontalLayout {
                    spacing: 10px;
                    padding-bottom: 14px;
                    Rectangle {
                        width: 64px;
                        height: 64px;
                        border-radius: 16px;
                        background: Ice.glow.with-alpha(0.16);
                        Image {
                            width: 64px;
                            height: 64px;
                            image-rendering: pixelated;
                            source: Sprites.pick(Ice.theme, "idle", false);
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        Text { text: "FubuNotch"; color: Ice.ink; font-size: 16px; font-weight: 800; }
                        Text { text: "v2 · Settings"; color: Ice.glow; font-size: 11px; font-weight: 600; }
                    }
                }
                Heading { text: "ISLAND"; }
                NavItem { label: "General"; accent: #8fa7bd; active: root.page == "general"; clicked => { root.page = "general"; } }
                NavItem { label: "Appearance"; accent: #ff7ac1; active: root.page == "look"; clicked => { root.page = "look"; } }
                NavItem { label: "Modules"; accent: #c08cff; active: root.page == "modules"; clicked => { root.page = "modules"; } }
                Rectangle { height: 8px; }
                Heading { text: "MODULES"; }
                NavItem { label: "Music"; accent: #5fd4ff; active: root.page == "music"; clicked => { root.page = "music"; } }
                NavItem { label: "Notifications"; accent: #a78bfa; active: root.page == "notifications"; clicked => { root.page = "notifications"; } }
                NavItem { label: "Water"; accent: #38bdf8; active: root.page == "water"; clicked => { root.page = "water"; } }
                NavItem { label: "Focus"; accent: #ff6b5b; active: root.page == "focus"; clicked => { root.page = "focus"; } }
                NavItem { label: "System"; accent: #4ade80; active: root.page == "system"; clicked => { root.page = "system"; } }
                NavItem { label: "Claude Code"; accent: #f29b38; active: root.page == "claude"; clicked => { root.page = "claude"; } }
                Rectangle { vertical-stretch: 1; }
            }
            // The divider the mascot climbs.
            Rectangle {
                x: parent.width - 1px;
                width: 1px;
                background: Ice.ink.with-alpha(0.08);
            }
        }

        // ── Content ──
        Flickable {
            content-height: content.preferred-height;
            content := VerticalLayout {
                padding: 28px;
                padding-top: 24px;
                padding-bottom: 120px;
                spacing: 14px;

                Text {
                    text: root.page == "general" ? "General" : root.page == "look" ? "Appearance" : root.page == "modules" ? "Modules"
                        : root.page == "music" ? "Music" : root.page == "notifications" ? "Notifications" : root.page == "water" ? "Water"
                        : root.page == "focus" ? "Focus" : root.page == "system" ? "System" : "Claude Code";
                    color: Ice.ink;
                    font-size: 22px;
                    font-weight: 800;
                }
                Text {
                    text: root.page == "general" ? "How the island behaves. Changes apply at once."
                        : root.page == "look" ? "A theme, its mascot, and a picture behind the island."
                        : root.page == "modules" ? "On or off, and the order of their tabs in the island."
                        : root.page == "music" ? "Now playing from any player, and synced lyrics."
                        : root.page == "notifications" ? "Windows notifications from the apps you choose."
                        : root.page == "water" ? "A glass at a time toward a daily goal."
                        : root.page == "focus" ? "Pomodoro rounds and breaks."
                        : root.page == "system" ? "Small notices for what changes on this PC."
                        : "Answer Claude Code's permission requests from the island.";
                    color: Ice.dim;
                    font-size: 12px;
                    wrap: word-wrap;
                }

                // ── General ──
                if root.page == "general" : Card {
                    SettingRow { title: "Start with Windows"; hint: "The island comes up when you sign in."; Toggle { on: root.s.autostart; toggled(v) => { root.flag-changed("autostart", v); } } }
                    SettingRow { title: "Pop up for activities"; hint: "The island drops down for new things. Questions from Claude Code always show."; Toggle { on: root.s.popups; toggled(v) => { root.flag-changed("general.popups", v); } } }
                    SettingRow {
                        title: "Hide when idle";
                        hint: "Seconds after the pointer leaves before the island goes back up.";
                        last: true;
                        Stepper { value: root.s.hide-after; minimum: 2; maximum: 60; unit: "s"; changed(v) => { root.number-changed("general.hide_after_s", v); } }
                    }
                }
                if root.page == "general" : Card {
                    SettingRow {
                        title: "Data folder";
                        hint: root.s.data-folder;
                        last: true;
                        SmallButton { label: "Open"; clicked => { root.action("open-data-folder"); } }
                    }
                }

                // ── Appearance ──
                if root.page == "look" : Heading { text: "THEME"; }
                if root.page == "look" : HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    ThemeCard { id: "fubuki"; name: "Fubuki"; c1: #5fd4ff; c2: #f4f6fb; chosen: root.s.theme == self.id; picked => { root.theme-picked(self.id); } }
                    ThemeCard { id: "mio"; name: "Mio"; c1: #ff5a6e; c2: #2a2228; chosen: root.s.theme == self.id; picked => { root.theme-picked(self.id); } }
                    ThemeCard { id: "towa"; name: "Towa"; c1: #c08cff; c2: #ff7ac1; chosen: root.s.theme == self.id; picked => { root.theme-picked(self.id); } }
                    ThemeCard { id: "azki"; name: "AZKi"; c1: #ff5d9e; c2: #3a1f2d; chosen: root.s.theme == self.id; picked => { root.theme-picked(self.id); } }
                    ThemeCard { id: "suisei"; name: "Suisei"; c1: #6aa0ff; c2: #f2c94c; chosen: root.s.theme == self.id; picked => { root.theme-picked(self.id); } }
                }
                if root.page == "look" : Card {
                    SettingRow { title: "Mascot on the island"; hint: "The member's pixel chibi on Home and in the capsule."; last: true; Toggle { on: root.s.mascot; toggled(v) => { root.flag-changed("look.mascot", v); } } }
                }
                if root.page == "look" : Heading { text: "BACKGROUND"; }
                if root.page == "look" : Card {
                    HorizontalLayout {
                        padding: 16px;
                        spacing: 16px;
                        Rectangle {
                            width: 208px;
                            height: 80px;
                            border-radius: 14px;
                            background: Ice.body-lo;
                            border-width: 1px;
                            border-color: Ice.ink.with-alpha(0.1);
                            if root.s.has-background : Image {
                                width: parent.width;
                                height: parent.height;
                                source: root.s.background-preview;
                                image-fit: fill;
                            }
                            if !root.s.has-background : Text { text: "No picture"; color: Ice.dim; font-size: 11.5px; }
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 8px;
                            Text { text: root.s.has-background ? root.s.background-name : "A picture behind the island, cropped to fit it."; color: Ice.ink; font-size: 12.5px; wrap: word-wrap; }
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                SmallButton { label: "Choose picture…"; primary: true; clicked => { root.action("background.pick"); } }
                                if root.s.has-background : SmallButton { label: "Remove"; clicked => { root.action("background.clear"); } }
                            }
                        }
                    }
                    SettingRow {
                        title: "Dim the picture";
                        hint: "How much of the theme colour covers it, so text stays readable.";
                        last: true;
                        Stepper { value: root.s.background-dim; minimum: 0; maximum: 90; step: 5; unit: "%"; changed(v) => { root.number-changed("look.background_dim", v); } }
                    }
                }

                // ── Modules ──
                if root.page == "modules" : Card {
                    for m[i] in root.s.modules : SettingRow {
                        title: m.name;
                        last: i == root.s.modules.length - 1;
                        HorizontalLayout {
                            spacing: 6px;
                            SmallButton { label: "↑"; enabled: i > 0; clicked => { root.module-moved(m.id, -1); } }
                            SmallButton { label: "↓"; enabled: i < root.s.modules.length - 1; clicked => { root.module-moved(m.id, 1); } }
                            Rectangle { width: 6px; }
                            Toggle { y: (parent.height - self.height) / 2; on: m.enabled; toggled(v) => { root.module-toggled(m.id, v); } }
                        }
                    }
                }

                // ── Music ──
                if root.page == "music" : Card {
                    SettingRow { title: "Synced lyrics"; hint: "Sends song title, artist, album and length to LRCLIB."; Toggle { on: root.s.lyrics; toggled(v) => { root.flag-changed("music.lyrics", v); } } }
                    SettingRow { title: "Lyrics from YouTube Music"; hint: "When LRCLIB has none. Unofficial endpoints: may stop working."; Toggle { on: root.s.lyrics-youtube; toggled(v) => { root.flag-changed("music.lyrics_youtube", v); } } }
                    SettingRow { title: "Japanese lyrics in romaji"; hint: ""; last: true; Toggle { on: root.s.romaji; toggled(v) => { root.flag-changed("music.romaji", v); } } }
                }

                // ── Notifications ──
                if root.page == "notifications" : Card {
                    SettingRow { title: "Pop up the island"; hint: "For each new notification from an app that is on."; last: true; Toggle { on: root.s.notif-popups; toggled(v) => { root.flag-changed("notifications.popups", v); } } }
                }
                if root.page == "notifications" : Heading { text: "APPS"; }
                if root.page == "notifications" : Card {
                    if root.s.notif-list.length == 0 : SettingRow {
                        title: "No apps yet";
                        hint: "Apps show up here once they send a notification. Every app is on until you turn it off.";
                        last: true;
                    }
                    for a[i] in root.s.notif-list : SettingRow {
                        title: a.name;
                        last: i == root.s.notif-list.length - 1;
                        Toggle { on: a.on; toggled(v) => { root.notif-app-toggled(a.name, v); } }
                    }
                }

                // ── Water ──
                if root.page == "water" : Card {
                    SettingRow { title: "Reminders"; hint: "A nudge after a while without a glass, inside the active hours."; Toggle { on: root.s.water-reminders; toggled(v) => { root.flag-changed("water.reminders", v); } } }
                    SettingRow { title: "Remind me after"; hint: "Minutes without a glass."; Stepper { value: root.s.water-every; minimum: 10; maximum: 480; step: 5; unit: "min"; changed(v) => { root.number-changed("water.every_min", v); } } }
                    SettingRow { title: "Active from"; hint: "No reminders before this."; Stepper { value: root.s.water-from; minimum: 0; maximum: root.s.water-until - 30; step: 30; time: true; changed(v) => { root.number-changed("water.from", v); } } }
                    SettingRow { title: "Active until"; hint: "No reminders after this."; Stepper { value: root.s.water-until; minimum: root.s.water-from + 30; maximum: 1439; step: 30; time: true; changed(v) => { root.number-changed("water.until", v); } } }
                    SettingRow { title: "Daily goal"; hint: ""; Stepper { value: root.s.water-goal; minimum: 100; maximum: 10000; step: 50; unit: "ml"; changed(v) => { root.number-changed("water.goal_ml", v); } } }
                    SettingRow { title: "Glass size"; hint: "What one tap on + adds."; last: true; Stepper { value: root.s.water-glass; minimum: 10; maximum: 2000; step: 10; unit: "ml"; changed(v) => { root.number-changed("water.glass_ml", v); } } }
                }

                // ── Focus ──
                if root.page == "focus" : Card {
                    SettingRow { title: "Focus"; hint: "Minutes in a round."; Stepper { value: root.s.focus-min; minimum: 1; maximum: 180; unit: "min"; changed(v) => { root.number-changed("focus.focus_min", v); } } }
                    SettingRow { title: "Short break"; hint: ""; Stepper { value: root.s.short-min; minimum: 1; maximum: 60; unit: "min"; changed(v) => { root.number-changed("focus.short_min", v); } } }
                    SettingRow { title: "Long break"; hint: ""; Stepper { value: root.s.long-min; minimum: 1; maximum: 120; unit: "min"; changed(v) => { root.number-changed("focus.long_min", v); } } }
                    SettingRow { title: "Long break every"; hint: "Focus rounds before a long break."; last: true; Stepper { value: root.s.rounds; minimum: 1; maximum: 12; unit: "rounds"; changed(v) => { root.number-changed("focus.rounds", v); } } }
                }

                // ── System ──
                if root.page == "system" : Card {
                    SettingRow { title: "Volume"; hint: ""; Toggle { on: root.s.sys-volume; toggled(v) => { root.flag-changed("system.volume", v); } } }
                    SettingRow { title: "Caps Lock"; hint: ""; Toggle { on: root.s.sys-caps; toggled(v) => { root.flag-changed("system.caps_lock", v); } } }
                    SettingRow { title: "Keyboard layout"; hint: ""; Toggle { on: root.s.sys-layout; toggled(v) => { root.flag-changed("system.keyboard_layout", v); } } }
                    SettingRow { title: "Charger"; hint: ""; Toggle { on: root.s.sys-charger; toggled(v) => { root.flag-changed("system.charger", v); } } }
                    SettingRow { title: "Network"; hint: ""; Toggle { on: root.s.sys-network; toggled(v) => { root.flag-changed("system.network", v); } } }
                    SettingRow { title: "Audio output"; hint: "Headphones connected or gone."; last: true; Toggle { on: root.s.sys-audio; toggled(v) => { root.flag-changed("system.audio_device", v); } } }
                }

                // ── Claude Code ──
                if root.page == "claude" : Card {
                    SettingRow {
                        title: root.s.claude-installed ? "Connected" : "Not connected";
                        hint: root.s.claude-status;
                        last: true;
                        SmallButton {
                            label: root.s.claude-installed ? "Disconnect…" : "Connect…";
                            primary: !root.s.claude-installed;
                            clicked => { root.claude-connect(!root.s.claude-installed); }
                        }
                    }
                }
            }
        }
    }

    // ── The mascot, on top of everything ──
    Rectangle {
        x: root.pet-x;
        y: root.pet-y;
        width: 128px;
        height: 128px;
        Image {
            width: parent.width;
            height: parent.height;
            image-rendering: pixelated;
            source: Sprites.pick(Ice.theme, root.pet-frame, root.pet-left);
        }
        TouchArea { mouse-cursor: pointer; clicked => { root.pet-clicked(); } }
        if root.pet-say != "" : Rectangle {
            // Above its head, kept inside the window.
            x: max(4px - root.pet-x, (parent.width - self.width) / 2);
            y: -20px;
            width: bubble.preferred-width + 20px;
            height: 26px;
            border-radius: 13px;
            background: Ice.ink;
            bubble := Text { text: root.pet-say; color: Ice.body-lo; font-size: 11.5px; font-weight: 700; }
        }
    }
}

export component Tray inherits SystemTrayIcon {
    icon: @image-url("../assets/tray.png");
    tooltip: "FubuNotch v2";
    callback open-settings();
    callback quit();
    Menu {
        MenuItem { title: "Settings…"; activated => { root.open-settings(); } }
        MenuSeparator { }
        MenuItem { title: "Quit FubuNotch v2"; activated => { root.quit(); } }
    }
}

/// A yes/no question before something is written outside FubuNotch.
export component ConfirmWindow inherits Window {
    title: "FubuNotch v2";
    preferred-width: 480px;
    background: Palette.background;
    in property <string> heading;
    in property <string> message;
    in property <string> confirm-label: "Confirm";
    callback answered(bool);
    VerticalLayout {
        padding: 18px;
        spacing: 12px;
        Text { text: root.heading; font-size: 15px; font-weight: 700; wrap: word-wrap; }
        Text { text: root.message; font-size: 12.5px; wrap: word-wrap; }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            Button { text: "Cancel"; clicked => { root.answered(false); } }
            Button { text: root.confirm-label; primary: true; clicked => { root.answered(true); } }
        }
    }
}
