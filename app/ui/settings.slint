// The Settings window and the tray icon. Every change goes to Rust at once
// and is saved there (settings.json), and the island follows right away;
// nothing here keeps state of its own beyond the page shown (and which side
// of the idle preview is being edited). The layout, after macOS' System
// Settings and Mini Island's look: a sidebar of pages with Segoe Fluent
// glyphs, then titled sections of cards made of rows (title, hint, control).
// Neutral greys throughout; the chosen theme only lends its accent.

// Space Mono (SIL OFL 1.1, assets/fonts/OFL.txt), built into the app.
import "../assets/fonts/SpaceMono-Regular.ttf";
import "../assets/fonts/SpaceMono-Bold.ttf";
// Allo (SIL OFL 1.1, assets/fonts/OFL-Allo.txt): the window's text.
import "../assets/fonts/Allo-Regular.otf";
import "../assets/fonts/Allo-Medium.otf";
import "../assets/fonts/Allo-SemiBold.otf";
import "../assets/fonts/Allo-Bold.otf";
import "../assets/fonts/Allo-ExtraBold.otf";
import { Button, Palette } from "std-widgets.slint";
import { Ice } from "theme.slint";

export struct ModuleRow {
    id: string,
    name: string,
    enabled: bool,
}

export struct AppSwitch {
    name: string,
    on: bool,
}

// An account on Settings > Accounts: who it is signed in as, a warning when
// two slots are one account.
export struct AccountSetting {
    id: string,
    name: string,
    signed-in-as: string,
    warning: string,
    active: bool,
    is-default: bool,
    can-sign-in: bool,
}

// A screen the island can sit on (Settings > General > Screen).
export struct ScreenRow {
    id: string,
    label: string,
}

export struct SettingsView {
    screens: [ScreenRow],
    screen: string,
    auto-screen: string,
    modules: [ModuleRow],
    lyrics: bool,
    lyrics-youtube: bool,
    romaji: bool,
    notif-popups: bool,
    // Windows lets Kanmuri read notifications.
    notif-access: bool,
    notif-list: [AppSwitch],
    sys-volume: bool,
    sys-caps: bool,
    sys-layout: bool,
    sys-charger: bool,
    sys-network: bool,
    sys-audio: bool,
    sys-mic-cam: bool,
    autostart: bool,
    mascot: bool,
    // The idle island's preview: the time now, today's date, the connection
    // ("wifi" | "ethernet" | "wifi-off") and the battery ("87%", "" for none).
    clock: string,
    date: string,
    net: string,
    battery: string,
    battery-level: float,
    popups: bool,
    idle-left: string,
    idle-right: string,
    // The word sides' text as the island shows it now ("Asar 15:12", "CPU 12%").
    idle-left-text: string,
    idle-right-text: string,
    hide-after: int,
    theme: string,
    has-background: bool,
    background-name: string,
    background-preview: image,
    background-dim: int,
    // Look: "black" | "color" | "wallpaper" | "liquid".
    look-style: string,
    glass-tint: string,
    look-color: color,
    // "#1f2a52", for the custom colour's field.
    look-color-hex: string,
    // The wallpaper's colour as the island would take it (black until read).
    wallpaper-color: color,
    night-warm: bool,
    night-warmth: int,
    closed-opacity: int,
    idle-w: int,
    idle-h: int,
    expanded-w: int,
    expanded-h: int,
    expanded-tall-h: int,
    water-reminders: bool,
    water-goal: int,
    water-glass: int,
    water-every: int,
    // Minutes after midnight.
    water-from: int,
    water-until: int,
    focus-min: int,
    short-min: int,
    long-min: int,
    rounds: int,
    // Prayer: the preset places and the chosen one, minutes before, at the time.
    prayer-places: [string],
    prayer-place: string,
    prayer-remind: int,
    prayer-at-time: bool,
    // Day Progress: wake and bedtime, minutes after midnight.
    day-wake: int,
    day-bedtime: int,
    data-folder: string,
    claude-status: string,
    claude-installed: bool,
}

// ── The look ─────────────────────────────────────────────────────────────────

// Mini Island's greys (island.ps1): near-black ground, #1C1C1E-ish cards,
// white ink and the label greys. The theme lends only its accent (Ice.glow).
global K {
    out property <color> ground: #111113;
    out property <color> side: #18181a;
    out property <color> card: #1c1c1e;
    out property <color> card-edge: #ffffff12;
    out property <color> line: #ffffff12;
    out property <color> ink: #ffffff;
    out property <color> text-2: #d2d2d7;
    out property <color> label: #b4b4ba;
    out property <color> hint: #8e8e93;
    out property <color> faint: #636366;
    out property <color> fill: #ffffff12;
    out property <color> fill-hover: #ffffff21;
    out property <color> tile: #2c2c2e;
    out property <color> on-accent: #0b0b0d;
    out property <string> icons: "Segoe Fluent Icons";
}

// Segoe Fluent Icons' glyphs, by page and by module.
global SetGlyphs {
    out property <string> up: "\u{E70E}";
    out property <string> down: "\u{E70D}";
    out property <string> add: "\u{E710}";
    out property <string> folder: "\u{E838}";
    out property <string> picture: "\u{EB9F}";
    out property <string> warning: "\u{E7BA}";
    out property <string> check: "\u{E73E}";
    out property <string> video: "\u{E714}";
    public pure function page(id: string) -> string {
        return id == "general" ? "\u{E713}"
            : id == "look" ? "\u{E790}"
            : id == "modules" ? "\u{F0E2}"
            : id == "music" ? "\u{E8D6}"
            : id == "notifications" ? "\u{EA8F}"
            : id == "water" ? "\u{EB42}"
            : id == "focus" ? "\u{E916}"
            : id == "prayer" ? "\u{E823}"
            : id == "day" ? "\u{EB05}"
            : id == "system" ? "\u{E7F4}"
            : id == "claude" ? "\u{E756}"
            : id == "todo" ? "\u{E73A}"
            : id == "shelf" ? "\u{E7B8}"
            : id == "accounts" ? "\u{E716}"
            : "\u{E713}";
    }
}

// ── Controls ─────────────────────────────────────────────────────────────────

component Glyph inherits Text {
    font-family: K.icons;
    horizontal-alignment: center;
    vertical-alignment: center;
}

// A text field (Settings > Accounts' names): Enter hands its text over.
component Field inherits Rectangle {
    in property <string> text;
    in property <string> placeholder;
    callback accepted(string);
    out property <string> value: input.text;
    height: 30px;
    border-radius: 8px;
    background: #ffffff10;
    border-width: 1px;
    border-color: input.has-focus ? Ice.glow : transparent;
    if input.text == "" : Text { x: 10px; height: parent.height; text: root.placeholder; color: #ffffff59; font-size: 12.5px; vertical-alignment: center; }
    input := TextInput {
        x: 10px;
        width: parent.width - 20px;
        height: parent.height;
        vertical-alignment: center;
        text: root.text;
        color: #ffffffeb;
        font-size: 12.5px;
        single-line: true;
        accepted => { root.accepted(self.text); }
    }
}

component Toggle inherits Rectangle {
    in property <bool> on;
    in property <bool> enabled: true;
    callback toggled(bool);
    width: 38px;
    height: 22px;
    border-radius: 11px;
    background: !enabled ? K.fill : on ? Ice.glow : a.has-hover ? #ffffff33 : #ffffff26;
    animate background { duration: 160ms; }
    Rectangle {
        width: 18px;
        height: 18px;
        y: 2px;
        x: root.on ? parent.width - self.width - 2px : 2px;
        animate x { duration: 180ms; easing: cubic-bezier(0.3, 1.4, 0.5, 1); }
        border-radius: 9px;
        background: root.on ? K.on-accent : K.ink;
    }
    a := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.toggled(!root.on); }
    }
}

component SmallButton inherits Rectangle {
    in property <string> label;
    in property <string> glyph;
    in property <bool> primary;
    in property <bool> enabled: true;
    callback clicked();
    width: root.label == "" ? 28px : row.preferred-width;
    height: 28px;
    border-radius: 7px;
    background: !enabled ? #ffffff08
        : primary ? (a.has-hover ? Ice.frost : Ice.glow)
        : a.has-hover ? K.fill-hover : K.fill;
    animate background { duration: 140ms; }
    row := HorizontalLayout {
        padding-left: root.label == "" ? 0 : 12px;
        padding-right: root.label == "" ? 0 : 12px;
        spacing: 6px;
        alignment: center;
        if root.glyph != "" : Glyph {
            text: root.glyph;
            font-size: 11px;
            color: root.primary ? K.on-accent : root.enabled ? K.ink : K.faint;
        }
        if root.label != "" : Text {
            text: root.label;
            vertical-alignment: center;
            color: root.primary ? K.on-accent : root.enabled ? K.ink : K.faint;
            font-size: 12.5px;
            font-weight: 600;
        }
    }
    a := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// − value + : whole numbers, or a time of day (minutes) when `time` is set.
component Stepper inherits Rectangle {
    in property <int> value;
    in property <int> step: 1;
    in property <int> minimum: 0;
    in property <int> maximum: 100;
    in property <string> unit;
    in property <bool> time;
    callback changed(int);
    width: 148px;
    height: 30px;
    border-radius: 8px;
    background: K.fill;
    HorizontalLayout {
        padding: 2px;
        minus := Rectangle {
            width: 30px;
            border-radius: 6px;
            background: ma.has-hover && ma.enabled ? K.fill-hover : transparent;
            Glyph { text: "\u{E738}"; font-size: 10px; color: ma.enabled ? K.ink : K.faint; }
            ma := TouchArea { enabled: root.value > root.minimum; mouse-cursor: pointer; clicked => { root.changed(max(root.minimum, root.value - root.step)); } }
        }
        Text {
            horizontal-stretch: 1;
            horizontal-alignment: center;
            vertical-alignment: center;
            text: root.time
                ? (floor(root.value / 60) < 10 ? "0" : "") + floor(root.value / 60) + ":" + (mod(root.value, 60) < 10 ? "0" : "") + mod(root.value, 60)
                : root.value + (root.unit == "" ? "" : " " + root.unit);
            color: K.ink;
            font-size: 12.5px;
            font-weight: 600;
        }
        Rectangle {
            width: 30px;
            border-radius: 6px;
            background: pa.has-hover && pa.enabled ? K.fill-hover : transparent;
            Glyph { text: "\u{E710}"; font-size: 10px; color: pa.enabled ? K.ink : K.faint; }
            pa := TouchArea { enabled: root.value < root.maximum; mouse-cursor: pointer; clicked => { root.changed(min(root.maximum, root.value + root.step)); } }
        }
    }
}

// One choice out of a few, side by side (macOS' segmented control).
component Segmented inherits Rectangle {
    in property <[ScreenRow]> choices;
    in property <string> value;
    callback picked(string);
    height: 30px;
    border-radius: 8px;
    background: K.fill;
    HorizontalLayout {
        padding: 2px;
        spacing: 2px;
        for c in root.choices : Rectangle {
            min-width: t.preferred-width + 26px;
            horizontal-stretch: 1;
            border-radius: 6px;
            background: c.id == root.value ? #5b5b60 : ca.has-hover ? #ffffff10 : transparent;
            animate background { duration: 140ms; }
            t := Text {
                text: c.label;
                color: c.id == root.value ? K.ink : K.label;
                font-size: 12.5px;
                font-weight: c.id == root.value ? 600 : 500;
            }
            ca := TouchArea { mouse-cursor: pointer; clicked => { root.picked(c.id); } }
        }
    }
}

// A glyph on a small grey tile, as macOS' Settings rows.
component IconTile inherits Rectangle {
    in property <string> glyph;
    in property <color> tint: K.ink;
    in property <length> size: 28px;
    width: root.size;
    height: root.size;
    border-radius: root.size / 4;
    background: K.tile;
    Glyph { text: root.glyph; font-size: root.size * 0.46; color: root.tint; }
}

// A row of a card: what it is on the left, its control on the right.
component SettingRow inherits Rectangle {
    in property <string> title;
    in property <string> hint;
    in property <string> glyph;
    in property <color> glyph-tint: K.ink;
    in property <bool> last;
    // A hint on two lines: the layout doesn't grow for wrapped text by itself.
    in property <bool> tall;
    min-height: root.tall ? 74px : root.hint == "" ? 48px : 58px;
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 14px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 12px;
        if root.glyph != "" : VerticalLayout {
            alignment: center;
            IconTile { glyph: root.glyph; tint: root.glyph-tint; }
        }
        VerticalLayout {
            alignment: center;
            spacing: 3px;
            horizontal-stretch: 1;
            Text { text: root.title; color: K.ink; font-size: 13.5px; font-weight: 500; wrap: word-wrap; }
            if root.hint != "" : Text { text: root.hint; color: K.hint; font-size: 12px; wrap: word-wrap; }
        }
        HorizontalLayout {
            alignment: end;
            spacing: 6px;
            VerticalLayout {
                alignment: center;
                @children
            }
        }
    }
    if !root.last : Rectangle {
        x: root.glyph != "" ? 56px : 16px;
        y: parent.height - 1px;
        width: parent.width - self.x;
        height: 1px;
        background: K.line;
    }
}

component Card inherits Rectangle {
    border-radius: 12px;
    background: K.card;
    border-width: 1px;
    border-color: K.card-edge;
    VerticalLayout {
        @children
    }
}

// One app's accounts on Settings > Accounts: each with its name (Enter
// renames), who it is signed in as, a warning, Sign in and Remove; a field to
// add one at the end. `act(action, id, value)`: "rename" / "remove" /
// "signin" with the account's id, "add" with the service and the name.
component AccountsCard inherits Card {
    in property <string> service;
    in property <[AccountSetting]> rows;
    in property <string> add-hint;
    callback act(string, string, string);
    for a[i] in root.rows : Rectangle {
        min-height: 64px;
        HorizontalLayout {
            padding-left: 16px;
            padding-right: 14px;
            padding-top: 10px;
            padding-bottom: 10px;
            spacing: 12px;
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 4px;
                alignment: center;
                HorizontalLayout {
                    spacing: 8px;
                    Field { width: 220px; text: a.name; accepted(t) => { root.act("rename", a.id, t); } }
                    if a.active : Text { text: "In use"; color: Ice.glow; font-size: 11.5px; font-weight: 600; vertical-alignment: center; }
                    if a.is-default : Text { text: "Main"; color: K.hint; font-size: 11.5px; vertical-alignment: center; }
                }
                Text { text: a.signed-in-as; color: K.hint; font-size: 12px; overflow: elide; }
                if a.warning != "" : Text { text: "⚠ " + a.warning + ": sign this one in again with the other account."; color: #ff9f0a; font-size: 12px; wrap: word-wrap; }
            }
            VerticalLayout {
                alignment: center;
                HorizontalLayout {
                    spacing: 6px;
                    if a.can-sign-in : SmallButton { label: "Sign in…"; clicked => { root.act("signin", a.id, ""); } }
                    if !a.is-default : SmallButton { label: "Remove"; enabled: !(root.service == "desktop" && a.active); clicked => { root.act("remove", a.id, ""); } }
                }
            }
        }
        Rectangle { x: 16px; y: parent.height - 1px; width: parent.width - 16px; height: 1px; background: K.line; }
    }
    // Add one.
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 14px;
        padding-top: 10px;
        padding-bottom: 12px;
        spacing: 8px;
        add-field := Field { width: 220px; placeholder: "New account's name"; accepted(t) => { root.act("add", root.service, t); } }
        SmallButton { label: "Add"; glyph: SetGlyphs.add; clicked => { root.act("add", root.service, add-field.value); } }
        Text { horizontal-stretch: 1; text: root.add-hint; color: K.hint; font-size: 12px; vertical-alignment: center; wrap: word-wrap; }
    }
}

// A section's name above its card.
component Heading inherits Rectangle {
    in property <string> text;
    height: 34px;
    Text {
        x: 6px;
        y: parent.height - self.height - 6px;
        text: root.text;
        color: K.hint;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.9px;
    }
}

component NavItem inherits Rectangle {
    in property <string> label;
    in property <string> id;
    in property <bool> active;
    callback clicked();
    height: 32px;
    border-radius: 8px;
    background: active ? #ffffff1c : a.has-hover ? #ffffff0d : transparent;
    animate background { duration: 140ms; }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;
        Glyph {
            width: 18px;
            text: SetGlyphs.page(root.id);
            font-size: 14px;
            color: root.active ? Ice.glow : K.label;
        }
        Text {
            text: root.label;
            color: root.active ? K.ink : K.text-2;
            font-size: 13px;
            font-weight: root.active ? 600 : 400;
            vertical-alignment: center;
        }
    }
    a := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// The idle island's connection mark (the island's own SysIcon paths).
component NetIcon inherits Path {
    in property <string> name;
    width: 16px;
    height: 16px;
    viewbox-width: 24;
    viewbox-height: 24;
    stroke-width: 1.8px;
    stroke: name == "wifi-off" ? K.label : K.ink;
    commands: name == "ethernet" ? "M 4 5 H 20 V 15 H 4 Z M 8 15 V 19 H 16 V 15 M 8 9 V 11 M 11 9 V 11 M 13 9 V 11 M 16 9 V 11"
        : name == "wifi-off" ? "M 2 9 A 15 15 0 0 1 22 9 M 5 12.5 A 10 10 0 0 1 19 12.5 M 8.5 16 A 5 5 0 0 1 15.5 16 M 3 3 L 21 21"
        : "M 2 9 A 15 15 0 0 1 22 9 M 5 12.5 A 10 10 0 0 1 19 12.5 M 8.5 16 A 5 5 0 0 1 15.5 16 M 12 19.5 V 20";
}

// The idle island's battery, as on the island.
component BatteryMark inherits Rectangle {
    in property <float> level;
    // No battery on this PC: the outline only.
    in property <bool> empty;
    width: 22px;
    height: 12px;
    Rectangle {
        x: 0; y: 0; width: 20px; height: 12px;
        border-radius: 3px;
        border-width: 1.2px;
        border-color: K.text-2;
        if !root.empty : Rectangle {
            x: 2px; y: 2px; height: parent.height - 4px;
            width: max(1px, (parent.width - 4px) * clamp(root.level, 0, 1));
            border-radius: 1.5px;
            background: root.level <= 0.2 ? #ff453a : K.ink;
        }
    }
    Rectangle { x: 20.5px; y: 4px; width: 1.5px; height: 4px; background: K.text-2; }
}

// One side of the idle island's preview: what it shows there, and a click
// picks the side to change.
component SlotZone inherits Rectangle {
    in property <string> kind;
    in property <string> text;
    in property <bool> selected;
    in property <string> date;
    in property <string> net;
    in property <string> battery;
    in property <float> level;
    callback clicked();
    width: max(46px, inner.preferred-width);
    height: 30px;
    border-radius: 15px;
    background: selected ? #ffffff26 : a.has-hover ? #ffffff14 : transparent;
    border-width: selected ? 1px : 0;
    border-color: Ice.glow.with-alpha(0.7);
    animate background { duration: 140ms; }
    inner := HorizontalLayout {
        padding-left: 11px;
        padding-right: 11px;
        spacing: 5px;
        alignment: center;
        if root.kind == "" : Glyph { text: SetGlyphs.add; font-size: 10px; color: K.hint; }
        if root.kind == "date" : Text { text: root.date; color: K.text-2; font-size: 13px; font-weight: 600; vertical-alignment: center; }
        if root.kind == "network" : NetIcon { name: root.net; y: (parent.height - self.height) / 2; }
        if root.kind == "battery" : BatteryMark { level: root.level; empty: root.battery == ""; y: (parent.height - self.height) / 2; }
        if root.kind == "battery" : Text { text: root.battery == "" ? "n/a" : root.battery; color: root.battery == "" ? K.hint : K.text-2; font-size: 13px; font-weight: 600; vertical-alignment: center; }
        if root.kind == "prayer" || root.kind == "cpu" || root.kind == "memory" || root.kind == "disk" : Text {
            text: root.text;
            color: K.text-2;
            font-size: 13px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
    a := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// A theme to pick: a small island in its colours, its name and swatches.
component ThemeCard inherits Rectangle {
    in property <string> id;
    in property <string> name;
    in property <bool> chosen;
    // The accent and the second colour, and the island's body.
    in property <color> c1;
    in property <color> c2;
    in property <color> body;
    callback picked();
    min-width: 140px;
    height: 132px;
    border-radius: 12px;
    background: a.has-hover && !chosen ? #232326 : K.card;
    border-width: chosen ? 2px : 1px;
    border-color: chosen ? Ice.glow : K.card-edge;
    animate background { duration: 140ms; }
    // The desk the island sits on.
    Rectangle {
        x: 8px;
        y: 8px;
        width: parent.width - 16px;
        height: 82px;
        border-radius: 8px;
        background: #0a0a0b;
        border-width: 1px;
        border-color: #ffffff0d;
        Rectangle {
            y: 12px;
            width: pill.preferred-width;
            x: (parent.width - self.width) / 2;
            height: 30px;
            border-radius: 15px;
            background: root.body;
            border-width: 1px;
            border-color: #ffffff29;
            pill := HorizontalLayout {
                padding-left: 9px;
                padding-right: 12px;
                spacing: 8px;
                alignment: center;
                Rectangle { width: 14px; height: 14px; y: (parent.height - self.height) / 2; border-radius: 7px; background: root.c1; }
                Text { text: "9:41"; color: #ffffff; font-size: 12.5px; font-weight: 700; vertical-alignment: center; }
                Rectangle {
                    width: 28px;
                    height: 4px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 2px;
                    background: root.c2.with-alpha(0.45);
                    Rectangle { x: 0; width: 17px; height: 4px; border-radius: 2px; background: root.c1; }
                }
            }
        }
        // A hint of the open island below: two lines of "content".
        Rectangle { x: (parent.width - 70px) / 2; y: 52px; width: 70px; height: 5px; border-radius: 2.5px; background: #ffffff1a; }
        Rectangle { x: (parent.width - 46px) / 2; y: 62px; width: 46px; height: 5px; border-radius: 2.5px; background: #ffffff10; }
    }
    HorizontalLayout {
        y: 98px;
        height: 26px;
        padding-left: 12px;
        padding-right: 12px;
        spacing: 5px;
        Text { text: root.name; color: K.ink; font-size: 12.5px; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; }
        if root.chosen : Glyph { text: SetGlyphs.check; font-size: 11px; color: Ice.glow; width: 14px; }
        if !root.chosen : Rectangle { width: 10px; height: 10px; y: (parent.height - self.height) / 2; border-radius: 5px; background: root.c1; }
        if !root.chosen : Rectangle { width: 10px; height: 10px; y: (parent.height - self.height) / 2; border-radius: 5px; background: root.c2; border-width: 1px; border-color: #ffffff1f; }
    }
    a := TouchArea { mouse-cursor: pointer; clicked => { root.picked(); } }
}

// A value along a track: drag or click anywhere on it; the value and its
// unit on the right.
component Slider inherits Rectangle {
    in property <int> value;
    in property <int> minimum: 0;
    in property <int> maximum: 100;
    in property <int> step: 1;
    in property <string> unit;
    callback changed(int);
    width: 250px;
    height: 30px;
    property <length> knob: 18px;
    property <length> track-w: self.width - 62px;
    property <length> travel: self.track-w - self.knob;
    property <float> frac: clamp((root.value - root.minimum) / max(1, root.maximum - root.minimum), 0, 1);
    function pick(x: length) {
        let f = clamp((x - root.knob / 2) / root.travel, 0, 1);
        let v = root.minimum + round(f * (root.maximum - root.minimum) / root.step) * root.step;
        if v != root.value {
            root.changed(v);
        }
    }
    // The track, and the part up to the knob in the accent.
    Rectangle {
        x: root.knob / 2;
        y: (parent.height - self.height) / 2;
        width: root.travel;
        height: 4px;
        border-radius: 2px;
        background: K.fill-hover;
    }
    Rectangle {
        x: root.knob / 2;
        y: (parent.height - self.height) / 2;
        width: root.travel * root.frac;
        height: 4px;
        border-radius: 2px;
        background: Ice.glow;
    }
    Rectangle {
        x: root.travel * root.frac;
        y: (parent.height - self.height) / 2;
        width: root.knob;
        height: root.knob;
        border-radius: root.knob / 2;
        background: area.pressed || area.has-hover ? #ffffff : #ececf0;
        border-width: 1px;
        border-color: #00000040;
    }
    area := TouchArea {
        width: root.track-w;
        mouse-cursor: pointer;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down {
                root.pick(self.mouse-x);
            }
        }
        moved => {
            if self.pressed {
                root.pick(self.mouse-x);
            }
        }
    }
    Text {
        x: root.track-w + 8px;
        width: parent.width - self.x;
        height: parent.height;
        text: root.value + (root.unit == "" ? "" : " " + root.unit);
        color: K.ink;
        font-size: 12.5px;
        font-weight: 600;
        horizontal-alignment: right;
        vertical-alignment: center;
    }
}

// One of the island's Looks: a small desk with the island on it, its name.
component LookCard inherits Rectangle {
    in property <string> id;
    in property <string> name;
    in property <bool> chosen;
    // The island's body in the preview, and its ink.
    in property <color> body;
    in property <color> ink: #ffffff;
    // Liquid Glass: the desk shows through, softened, with a bright rim and sheen.
    in property <bool> liquid;
    callback picked();
    min-width: 100px;
    height: 108px;
    border-radius: 12px;
    background: a.has-hover && !chosen ? #232326 : K.card;
    border-width: chosen ? 2px : 1px;
    border-color: chosen ? Ice.glow : K.card-edge;
    animate background { duration: 140ms; }
    // The desk, with three colours on it so see-through shows.
    Rectangle {
        x: 8px;
        y: 8px;
        width: parent.width - 16px;
        height: 64px;
        border-radius: 8px;
        background: #26222e;
        border-width: 1px;
        border-color: #ffffff0d;
        Rectangle { x: 6px; y: 8px; width: parent.width * 0.42; height: 22px; border-radius: 11px; background: #b0408a; }
        Rectangle { x: parent.width * 0.5; y: 4px; width: parent.width * 0.44; height: 18px; border-radius: 9px; background: #e09a2c; }
        Rectangle { x: parent.width * 0.2; y: 34px; width: parent.width * 0.6; height: 20px; border-radius: 10px; background: #2f7fd0; }
        Rectangle {
            y: 10px;
            width: parent.width - 28px;
            x: 14px;
            height: 24px;
            border-radius: 12px;
            background: root.liquid ? #6a6474.with-alpha(0.42) : root.body;
            border-width: 1px;
            border-color: root.liquid ? #ffffff8c : root.ink.with-alpha(0.18);
            // The sheen near the top and the lens' lighter band at the bottom.
            if root.liquid : Rectangle { x: 6px; y: 2px; width: parent.width - 12px; height: 7px; border-radius: 3.5px; background: #ffffff2e; }
            if root.liquid : Rectangle { x: 10px; y: parent.height - 4px; width: parent.width - 20px; height: 2px; border-radius: 1px; background: #ffffff24; }
            Text { text: "9:41"; color: root.ink; font-size: 11.5px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
        }
    }
    HorizontalLayout {
        y: 76px;
        height: 26px;
        padding-left: 10px;
        padding-right: 10px;
        spacing: 4px;
        Text { text: root.name; color: K.ink; font-size: 12px; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
        if root.chosen : Glyph { text: SetGlyphs.check; font-size: 11px; color: Ice.glow; width: 14px; }
    }
    a := TouchArea { mouse-cursor: pointer; clicked => { root.picked(); } }
}

// A round colour to pick for the Color look.
component Swatch inherits Rectangle {
    in property <color> c;
    in property <bool> chosen;
    callback picked();
    width: 30px;
    height: 30px;
    border-radius: 15px;
    background: chosen ? Ice.glow : a.has-hover ? #ffffff40 : transparent;
    Rectangle {
        x: 3px;
        y: 3px;
        width: 24px;
        height: 24px;
        border-radius: 12px;
        background: root.c;
        border-width: 1px;
        border-color: #ffffff30;
    }
    a := TouchArea { mouse-cursor: pointer; clicked => { root.picked(); } }
}

// ── The window ───────────────────────────────────────────────────────────────

export component SettingsWindow inherits Window {
    default-font-family: "Allo";
    title: "Kanmuri · Settings";
    preferred-width: 900px;
    preferred-height: 620px;
    min-width: 760px;
    min-height: 520px;
    // Opaque: without it the software renderer leaves the window see-through.
    // `repaint` flips (a shade no eye can tell) when Windows asks for the
    // window again, so the whole of it is redrawn (see repaint_on_expose).
    in property <bool> repaint;
    background: root.repaint ? K.ground : K.ground.with-alpha(0.999);

    in property <SettingsView> s;
    in-out property <string> page: "general";
    // Which side of the idle island the choices below its preview change.
    in-out property <string> slot-side: "left";

    callback module-toggled(string, bool);
    callback module-moved(string, int);
    /// A switch, by key: "music.lyrics", "system.volume", "autostart"…
    callback flag-changed(string, bool);
    /// A number, by key: "water.goal_ml", "focus.rounds", "water.from" (minutes)…
    callback number-changed(string, int);
    callback apps-changed(string);
    callback notif-app-toggled(string, bool);
    callback theme-picked(string);
    // Appearance → Look, and the Color look's colour ("#rrggbb").
    callback look-picked(string);
    callback color-picked(string);
    callback screen-picked(string);
    callback place-picked(string);
    callback slot-picked(string, string);
    /// "background.pick", "background.clear", "open-data-folder".
    callback action(string);
    callback claude-connect(bool);
    // Settings > Accounts.
    in property <[AccountSetting]> accounts-desktop;
    in property <[AccountSetting]> accounts-claude;
    in property <[AccountSetting]> accounts-codex;
    in property <string> account-note;
    callback account-act(string, string, string);
    // A byte as two hex digits: the swatches' "#rrggbb".
    pure function hex(v: int) -> string {
        return root.digit(floor(v / 16)) + root.digit(mod(v, 16));
    }
    pure function digit(v: int) -> string {
        return v == 0 ? "0" : v == 1 ? "1" : v == 2 ? "2" : v == 3 ? "3" : v == 4 ? "4" : v == 5 ? "5" : v == 6 ? "6" : v == 7 ? "7"
            : v == 8 ? "8" : v == 9 ? "9" : v == 10 ? "a" : v == 11 ? "b" : v == 12 ? "c" : v == 13 ? "d" : v == 14 ? "e" : "f";
    }

    HorizontalLayout {
        // ── Sidebar ──
        Rectangle {
            width: 220px;
            background: K.side;
            VerticalLayout {
                padding: 12px;
                padding-top: 18px;
                spacing: 2px;
                HorizontalLayout {
                    padding-left: 6px;
                    padding-bottom: 18px;
                    spacing: 11px;
                    Rectangle {
                        width: 38px;
                        height: 38px;
                        border-radius: 10px;
                        background: K.tile;
                        border-width: 1px;
                        border-color: #ffffff14;
                        // A crown (kanmuri).
                        Path {
                            width: 22px;
                            height: 22px;
                            viewbox-width: 24;
                            viewbox-height: 24;
                            fill: Ice.glow;
                            commands: "M 2.5 7.5 L 7.5 12 L 12 4.5 L 16.5 12 L 21.5 7.5 L 19.2 17.5 H 4.8 Z M 4.8 19 H 19.2 V 21 H 4.8 Z";
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 0px;
                        Text { text: "Kanmuri"; color: K.ink; font-size: 15px; font-weight: 700; }
                        Text { text: "Settings"; color: K.hint; font-size: 12px; }
                    }
                }
                Heading { text: "ISLAND"; height: 26px; }
                NavItem { label: "General"; id: "general"; active: root.page == "general"; clicked => { root.page = "general"; } }
                NavItem { label: "Appearance"; id: "look"; active: root.page == "look"; clicked => { root.page = "look"; } }
                NavItem { label: "Modules"; id: "modules"; active: root.page == "modules"; clicked => { root.page = "modules"; } }
                Heading { text: "MODULES"; height: 36px; }
                NavItem { label: "Music"; id: "music"; active: root.page == "music"; clicked => { root.page = "music"; } }
                NavItem { label: "Notifications"; id: "notifications"; active: root.page == "notifications"; clicked => { root.page = "notifications"; } }
                NavItem { label: "Water"; id: "water"; active: root.page == "water"; clicked => { root.page = "water"; } }
                NavItem { label: "Focus"; id: "focus"; active: root.page == "focus"; clicked => { root.page = "focus"; } }
                NavItem { label: "Prayer"; id: "prayer"; active: root.page == "prayer"; clicked => { root.page = "prayer"; } }
                NavItem { label: "Day Progress"; id: "day"; active: root.page == "day"; clicked => { root.page = "day"; } }
                NavItem { label: "System"; id: "system"; active: root.page == "system"; clicked => { root.page = "system"; } }
                NavItem { label: "Claude Code"; id: "claude"; active: root.page == "claude"; clicked => { root.page = "claude"; } }
                NavItem { label: "Accounts"; id: "accounts"; active: root.page == "accounts"; clicked => { root.page = "accounts"; root.action("accounts.refresh"); } }
                Rectangle { vertical-stretch: 1; }
            }
            Rectangle {
                x: parent.width - 1px;
                width: 1px;
                background: #ffffff0f;
            }
        }

        // ── Content ──
        Flickable {
            content-height: content.preferred-height;
            content := VerticalLayout {
                padding-left: 32px;
                padding-right: 32px;
                padding-top: 28px;
                padding-bottom: 40px;
                spacing: 0px;

                // The page's title.
                HorizontalLayout {
                    spacing: 14px;
                    padding-bottom: 8px;
                    IconTile { size: 44px; glyph: SetGlyphs.page(root.page); }
                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        Text {
                            text: root.page == "general" ? "General" : root.page == "look" ? "Appearance" : root.page == "modules" ? "Modules"
                                : root.page == "music" ? "Music" : root.page == "notifications" ? "Notifications" : root.page == "water" ? "Water"
                                : root.page == "focus" ? "Focus" : root.page == "prayer" ? "Prayer" : root.page == "day" ? "Day Progress" : root.page == "system" ? "System" : root.page == "accounts" ? "Accounts" : "Claude Code";
                            color: K.ink;
                            font-size: 24px;
                            font-weight: 700;
                        }
                        Text {
                            text: root.page == "general" ? "How the island behaves. Changes apply at once."
                                : root.page == "look" ? "The island's body, its size, an accent and a picture behind it."
                                : root.page == "modules" ? "On or off, and the order of their tabs in the island."
                                : root.page == "music" ? "Now playing from any player, and synced lyrics."
                                : root.page == "notifications" ? "Windows notifications from the apps you choose."
                                : root.page == "water" ? "A glass at a time toward a daily goal."
                                : root.page == "focus" ? "Pomodoro rounds and breaks."
                                : root.page == "prayer" ? "Today's prayer times (Kemenag), worked out on this PC."
                                : root.page == "day" ? "How much of your day, week, month and year has gone."
                                : root.page == "accounts" ? "The Claude Desktop, Claude Code and Codex accounts the island switches between."
                                : root.page == "system" ? "Small notices for what changes on this PC."
                                : "Answer Claude Code's permission requests from the island.";
                            color: K.hint;
                            font-size: 13px;
                            wrap: word-wrap;
                        }
                    }
                }

                // ── General ──
                if root.page == "general" && root.s.screens.length > 1 : Heading { text: "SCREEN"; }
                if root.page == "general" && root.s.screens.length > 1 : Card {
                    SettingRow {
                        title: "Screen";
                        hint: "Which screen the island sits on (its home).";
                        Segmented {
                            choices: root.s.screens;
                            value: root.s.screen;
                            picked(id) => { root.screen-picked(id); }
                        }
                    }
                    SettingRow {
                        title: "Move automatically";
                        hint: root.s.auto-screen == "fullscreen" ? "Away from a fullscreen video or game."
                            : root.s.auto-screen == "unused" ? "Always on a screen you are not using."
                            : root.s.auto-screen == "follow" ? "Goes to the screen you are using."
                            : "Stays on its home screen.";
                        last: true;
                        Segmented {
                            choices: [{id: "auto:off", label: "Off"}, {id: "auto:fullscreen", label: "Fullscreen"}, {id: "auto:unused", label: "Free screen"}, {id: "auto:follow", label: "Follow me"}];
                            value: "auto:" + (root.s.auto-screen == "" ? "off" : root.s.auto-screen);
                            picked(id) => { root.screen-picked(id); }
                        }
                    }
                }
                if root.page == "general" : Heading { text: "IDLE ISLAND"; }
                if root.page == "general" : Card {
                    // The closed island as it looks now; a click on a side
                    // picks what the choices below change.
                    Rectangle {
                        height: 150px;
                        Rectangle {
                            x: 14px;
                            y: 14px;
                            width: parent.width - 28px;
                            height: parent.height - 14px;
                            border-radius: 10px;
                            background: #0a0a0b;
                            border-width: 1px;
                            border-color: #ffffff0d;
                            Rectangle {
                                y: 22px;
                                width: island.preferred-width;
                                x: (parent.width - self.width) / 2;
                                height: 40px;
                                border-radius: 20px;
                                background: #000000;
                                border-width: 1px;
                                border-color: #ffffff29;
                                island := HorizontalLayout {
                                    padding-left: 5px;
                                    padding-right: 5px;
                                    spacing: 4px;
                                    alignment: center;
                                    SlotZone {
                                        y: (parent.height - self.height) / 2;
                                        kind: root.s.idle-left;
                                        text: root.s.idle-left-text;
                                        selected: root.slot-side == "left";
                                        date: root.s.date; net: root.s.net; battery: root.s.battery; level: root.s.battery-level;
                                        clicked => { root.slot-side = "left"; }
                                    }
                                    Text {
                                        text: root.s.clock;
                                        color: K.ink;
                                        font-size: 16px;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }
                                    SlotZone {
                                        y: (parent.height - self.height) / 2;
                                        kind: root.s.idle-right;
                                        text: root.s.idle-right-text;
                                        selected: root.slot-side == "right";
                                        date: root.s.date; net: root.s.net; battery: root.s.battery; level: root.s.battery-level;
                                        clicked => { root.slot-side = "right"; }
                                    }
                                }
                            }
                            Text {
                                y: 84px;
                                width: parent.width;
                                horizontal-alignment: center;
                                text: "Click the left or right of the island to choose what goes there.";
                                color: K.hint;
                                font-size: 12px;
                            }
                        }
                    }
                    // Eight choices: the title and hint above, the choices on a row of their own.
                    VerticalLayout {
                        padding-left: 16px;
                        padding-right: 14px;
                        padding-top: 10px;
                        padding-bottom: 12px;
                        spacing: 8px;
                        Text { text: root.slot-side == "left" ? "Left of the time" : "Right of the time"; color: K.ink; font-size: 13.5px; font-weight: 500; }
                        Text {
                            text: "Battery shows only on a laptop. Prayer is the next one (place in Settings > Prayer). CPU, RAM and Disk update every 2 s while the island is up.";
                            color: K.hint;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            alignment: start;
                            Segmented {
                                choices: [{id: "", label: "None"}, {id: "date", label: "Date"}, {id: "network", label: "Network"}, {id: "battery", label: "Battery"}, {id: "prayer", label: "Prayer"}, {id: "cpu", label: "CPU"}, {id: "memory", label: "RAM"}, {id: "disk", label: "Disk"}];
                                value: root.slot-side == "left" ? root.s.idle-left : root.s.idle-right;
                                picked(id) => { root.slot-picked(root.slot-side, id); }
                            }
                        }
                    }
                }
                if root.page == "general" : Heading { text: "BEHAVIOUR"; }
                if root.page == "general" : Card {
                    SettingRow { title: "Start with Windows"; hint: "The island comes up when you sign in."; Toggle { on: root.s.autostart; toggled(v) => { root.flag-changed("autostart", v); } } }
                    SettingRow { title: "Pop up for activities"; tall: true; hint: "The island drops down for new things. Questions from Claude Code always show."; Toggle { on: root.s.popups; toggled(v) => { root.flag-changed("general.popups", v); } } }
                    SettingRow {
                        title: "Hide when idle";
                        tall: true;
                        hint: "Seconds after the pointer leaves before the island goes back up.";
                        last: true;
                        Stepper { value: root.s.hide-after; minimum: 2; maximum: 60; unit: "s"; changed(v) => { root.number-changed("general.hide_after_s", v); } }
                    }
                }
                if root.page == "general" : Heading { text: "DATA"; }
                if root.page == "general" : Card {
                    SettingRow {
                        title: "Data folder";
                        hint: root.s.data-folder;
                        glyph: SetGlyphs.folder;
                        last: true;
                        SmallButton { label: "Open"; clicked => { root.action("open-data-folder"); } }
                    }
                }

                // ── Appearance ──
                if root.page == "look" : Heading { text: "LOOK"; }
                if root.page == "look" : HorizontalLayout {
                    spacing: 10px;
                    LookCard { id: "black"; name: "Black"; body: #0b0b0d; chosen: root.s.look-style == self.id; picked => { root.look-picked(self.id); } }
                    LookCard {
                        id: "color";
                        name: "Color";
                        body: root.s.look-color;
                        ink: (0.2126 * root.s.look-color.red + 0.7152 * root.s.look-color.green + 0.0722 * root.s.look-color.blue) / 255 > 0.55 ? #141416 : #ffffff;
                        chosen: root.s.look-style == self.id;
                        picked => { root.look-picked(self.id); }
                    }
                    LookCard { id: "wallpaper"; name: "Wallpaper"; body: root.s.wallpaper-color; chosen: root.s.look-style == self.id; picked => { root.look-picked(self.id); } }
                    LookCard { id: "liquid"; name: "Liquid Glass"; liquid: true; chosen: root.s.look-style == self.id; picked => { root.look-picked(self.id); } }
                }
                if root.page == "look" : Rectangle {
                    height: 30px;
                    Text {
                        x: 6px;
                        width: parent.width - 12px;
                        vertical-alignment: center;
                        color: K.hint;
                        font-size: 12px;
                        wrap: word-wrap;
                        text: root.s.look-style == "color" ? "The island in the colour picked below. Light colours get dark text."
                            : root.s.look-style == "wallpaper" ? "The island takes your wallpaper's colour, darkened so text stays readable."
                            : root.s.look-style == "liquid" ? "Glass over what is behind the island. Not seen in screenshots or recordings while on."
                            : "A solid black island.";
                    }
                }
                // Liquid Glass' tint: by what is behind it, or always dark / light.
                if root.page == "look" && root.s.look-style == "liquid" : HorizontalLayout {
                    padding-left: 6px;
                    spacing: 6px;
                    alignment: start;
                    for t in [{id: "auto", l: "Auto"}, {id: "dark", l: "Dark"}, {id: "light", l: "Light"}] : SmallButton {
                        label: t.l;
                        primary: root.s.glass-tint == t.id;
                        clicked => { root.look-picked("tint:" + t.id); }
                    }
                }
                if root.page == "look" : Heading { text: "COLOR"; }
                if root.page == "look" : Card {
                    SettingRow {
                        title: "Island colour";
                        hint: "For the Color look. Picking one switches to it.";
                        HorizontalLayout {
                            spacing: 4px;
                            for c in [#1f2a52, #5e2a84, #0f4c4a, #5c1624, #2c2c2e, #f5f5f7, #ff9fc7, #ffd60a] : Swatch {
                                c: c;
                                chosen: root.s.look-style == "color" && root.s.look-color == c;
                                picked => { root.color-picked("#" + root.hex(c.red) + root.hex(c.green) + root.hex(c.blue)); }
                            }
                        }
                    }
                    SettingRow {
                        title: "Custom colour";
                        hint: "A hex colour, e.g. #3a6ea5, then Enter.";
                        last: true;
                        HorizontalLayout {
                            spacing: 8px;
                            Rectangle {
                                width: 24px;
                                height: 24px;
                                y: 3px;
                                border-radius: 12px;
                                background: root.s.look-color;
                                border-width: 1px;
                                border-color: #ffffff30;
                            }
                            Rectangle {
                                width: 110px;
                                height: 30px;
                                border-radius: 8px;
                                background: K.fill;
                                border-width: 1px;
                                border-color: hex-input.has-focus ? Ice.glow : transparent;
                                hex-input := TextInput {
                                    x: 10px;
                                    width: parent.width - 20px;
                                    height: parent.height;
                                    vertical-alignment: center;
                                    text: root.s.look-color-hex;
                                    color: K.ink;
                                    font-size: 12.5px;
                                    font-family: "Space Mono";
                                    single-line: true;
                                    accepted => { root.color-picked(self.text); }
                                }
                            }
                        }
                    }
                }
                if root.page == "look" : Heading { text: "NIGHT"; }
                if root.page == "look" : Card {
                    SettingRow {
                        title: "Warmer colors at night";
                        hint: "After sunset the island eases warmer over 45 min, back at sunrise. Sunset from the Prayer module's place, else 18:00 to 06:00.";
                        tall: true;
                        Toggle { on: root.s.night-warm; toggled(v) => { root.flag-changed("look.night_warm", v); } }
                    }
                    SettingRow {
                        title: "Night warmth";
                        last: true;
                        Slider { value: root.s.night-warmth; minimum: 0; maximum: 100; step: 5; unit: "%"; changed(v) => { root.number-changed("look.night_warmth", v); } }
                    }
                }
                if root.page == "look" : Heading { text: "CLOSED ISLAND"; }
                if root.page == "look" : Card {
                    SettingRow {
                        title: "Opacity when closed";
                        hint: "The quiet capsule lets the screen show through; solid while hovered, open or showing an alert.";
                        tall: true;
                        last: true;
                        Slider { value: root.s.closed-opacity; minimum: 20; maximum: 100; step: 5; unit: "%"; changed(v) => { root.number-changed("look.closed_opacity", v); } }
                    }
                }
                if root.page == "look" : Heading { text: "SIZE"; }
                if root.page == "look" : Card {
                    SettingRow { title: "Idle width"; Slider { value: root.s.idle-w; minimum: 140; maximum: 260; step: 2; unit: "px"; changed(v) => { root.number-changed("look.idle_w", v); } } }
                    SettingRow { title: "Idle height"; Slider { value: root.s.idle-h; minimum: 36; maximum: 56; unit: "px"; changed(v) => { root.number-changed("look.idle_h", v); } } }
                    SettingRow { title: "Open width"; Slider { value: root.s.expanded-w; minimum: 600; maximum: 760; step: 4; unit: "px"; changed(v) => { root.number-changed("look.expanded_w", v); } } }
                    SettingRow { title: "Open height"; hint: "Music, Prayer and other normal pages."; Slider { value: root.s.expanded-h; minimum: 170; maximum: 260; step: 2; unit: "px"; changed(v) => { root.number-changed("look.expanded_h", v); } } }
                    SettingRow { title: "Open height, tall pages"; hint: "Lyrics."; last: true; Slider { value: root.s.expanded-tall-h; minimum: 220; maximum: 360; step: 2; unit: "px"; changed(v) => { root.number-changed("look.expanded_tall_h", v); } } }
                }
                if root.page == "look" : Heading { text: "THEME"; }
                if root.page == "look" : GridLayout {
                    spacing: 10px;
                    Row {
                        ThemeCard { id: "graphite"; name: "Graphite"; c1: #f2f2f7; c2: #636366; body: #050505; chosen: root.s.theme == self.id; picked => { root.theme-picked(self.id); } }
                        ThemeCard { id: "fubuki"; name: "Ice"; c1: #5fd4ff; c2: #f4f6fb; body: #0b1424; chosen: root.s.theme == self.id; picked => { root.theme-picked(self.id); } }
                        ThemeCard { id: "mio"; name: "Crimson"; c1: #ff5a6e; c2: #ffc2ca; body: #160b10; chosen: root.s.theme == self.id; picked => { root.theme-picked(self.id); } }
                    }
                    Row {
                        ThemeCard { id: "towa"; name: "Violet"; c1: #c08cff; c2: #ff7ac1; body: #120c1f; chosen: root.s.theme == self.id; picked => { root.theme-picked(self.id); } }
                        ThemeCard { id: "azki"; name: "Rose"; c1: #ff5d9e; c2: #ffc6dc; body: #170c16; chosen: root.s.theme == self.id; picked => { root.theme-picked(self.id); } }
                        ThemeCard { id: "suisei"; name: "Comet"; c1: #6aa0ff; c2: #f2c94c; body: #0a1030; chosen: root.s.theme == self.id; picked => { root.theme-picked(self.id); } }
                    }
                }
                if root.page == "look" : Heading { text: "BACKGROUND"; }
                if root.page == "look" : Card {
                    HorizontalLayout {
                        padding: 14px;
                        padding-left: 16px;
                        spacing: 16px;
                        Rectangle {
                            width: 200px;
                            height: 78px;
                            border-radius: 10px;
                            background: #0a0a0b;
                            border-width: 1px;
                            border-color: #ffffff14;
                            if root.s.has-background : Image {
                                x: 1px;
                                y: 1px;
                                width: parent.width - 2px;
                                height: parent.height - 2px;
                                source: root.s.background-preview;
                                image-fit: fill;
                            }
                            if !root.s.has-background : VerticalLayout {
                                alignment: center;
                                spacing: 4px;
                                Glyph { text: SetGlyphs.picture; font-size: 18px; color: K.faint; }
                                Text { text: "No picture"; color: K.hint; font-size: 12px; horizontal-alignment: center; }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 10px;
                            Text { text: root.s.has-background ? root.s.background-name : "A picture behind the island, cropped to fit it."; color: K.text-2; font-size: 13px; wrap: word-wrap; }
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                SmallButton { label: "Choose picture…"; primary: true; clicked => { root.action("background.pick"); } }
                                if root.s.has-background : SmallButton { label: "Remove"; clicked => { root.action("background.clear"); } }
                            }
                        }
                    }
                    Rectangle { height: 1px; Rectangle { x: 16px; width: parent.width - 16px; height: 1px; background: K.line; } }
                    SettingRow {
                        title: "Dim the picture";
                        hint: "How much of the theme colour covers it, so text stays readable.";
                        tall: true;
                        last: true;
                        Stepper { value: root.s.background-dim; minimum: 0; maximum: 90; step: 5; unit: "%"; changed(v) => { root.number-changed("look.background_dim", v); } }
                    }
                }

                // ── Modules ──
                if root.page == "modules" : Heading { text: "ISLAND TABS"; }
                if root.page == "modules" : Card {
                    for m[i] in root.s.modules : SettingRow {
                        title: m.name;
                        glyph: SetGlyphs.page(m.id);
                        glyph-tint: m.enabled ? K.ink : K.faint;
                        last: i == root.s.modules.length - 1;
                        HorizontalLayout {
                            spacing: 4px;
                            SmallButton { glyph: SetGlyphs.up; enabled: i > 0; clicked => { root.module-moved(m.id, -1); } }
                            SmallButton { glyph: SetGlyphs.down; enabled: i < root.s.modules.length - 1; clicked => { root.module-moved(m.id, 1); } }
                            Rectangle { width: 10px; }
                            Toggle { y: (parent.height - self.height) / 2; on: m.enabled; toggled(v) => { root.module-toggled(m.id, v); } }
                        }
                    }
                }

                // ── Music ──
                if root.page == "music" : Heading { text: "LYRICS"; }
                if root.page == "music" : Card {
                    SettingRow { title: "Synced lyrics"; hint: "Sends song title, artist, album and length to LRCLIB."; Toggle { on: root.s.lyrics; toggled(v) => { root.flag-changed("music.lyrics", v); } } }
                    SettingRow { title: "Lyrics from YouTube Music"; hint: "When LRCLIB has none. Unofficial endpoints: may stop working."; Toggle { on: root.s.lyrics-youtube; toggled(v) => { root.flag-changed("music.lyrics_youtube", v); } } }
                    SettingRow { title: "Japanese lyrics in romaji"; hint: ""; last: true; Toggle { on: root.s.romaji; toggled(v) => { root.flag-changed("music.romaji", v); } } }
                }
                if root.page == "music" : Heading { text: "WATCH IN ISLAND"; }
                if root.page == "music" : Card {
                    SettingRow {
                        title: "Picture-in-picture docks under the island";
                        hint: "In Chrome or Edge: YouTube's PiP button, right-click a video twice, or the PiP button in Chrome's media controls.";
                        glyph: SetGlyphs.video;
                        tall: true;
                        last: true;
                    }
                }

                // ── Notifications ──
                if root.page == "notifications" : Heading { text: "POP-UPS"; }
                if root.page == "notifications" : Card {
                    SettingRow {
                        title: "Pop up the island";
                        tall: true;
                        hint: "Windows' own pop-ups stay off while this module is on; off, or quitting Kanmuri, brings them back.";
                        last: root.s.notif-access;
                        Toggle { on: root.s.notif-popups; toggled(v) => { root.flag-changed("notifications.popups", v); } }
                    }
                    if !root.s.notif-access : SettingRow {
                        title: "No access to notifications";
                        tall: true;
                        glyph: SetGlyphs.warning;
                        glyph-tint: #ff9f0a;
                        hint: "Needs access: Windows Settings → Privacy & security → Notifications → let apps read them.";
                        last: true;
                    }
                }
                if root.page == "notifications" : Heading { text: "APPS"; }
                if root.page == "notifications" : Card {
                    if root.s.notif-list.length == 0 : SettingRow {
                        title: "No apps yet";
                        tall: true;
                        hint: "Apps show up here once they send a notification. Every app is on until you turn it off.";
                        last: true;
                    }
                    for a[i] in root.s.notif-list : SettingRow {
                        title: a.name;
                        last: i == root.s.notif-list.length - 1;
                        Toggle { on: a.on; toggled(v) => { root.notif-app-toggled(a.name, v); } }
                    }
                }

                // ── Water ──
                if root.page == "water" : Heading { text: "REMINDERS"; }
                if root.page == "water" : Card {
                    SettingRow { title: "Reminders"; hint: "A nudge after a while without a glass, inside the active hours."; Toggle { on: root.s.water-reminders; toggled(v) => { root.flag-changed("water.reminders", v); } } }
                    SettingRow { title: "Remind me after"; hint: "Minutes without a glass."; Stepper { value: root.s.water-every; minimum: 10; maximum: 480; step: 5; unit: "min"; changed(v) => { root.number-changed("water.every_min", v); } } }
                    SettingRow { title: "Active from"; hint: "No reminders before this."; Stepper { value: root.s.water-from; minimum: 0; maximum: root.s.water-until - 30; step: 30; time: true; changed(v) => { root.number-changed("water.from", v); } } }
                    SettingRow { title: "Active until"; hint: "No reminders after this."; last: true; Stepper { value: root.s.water-until; minimum: root.s.water-from + 30; maximum: 1439; step: 30; time: true; changed(v) => { root.number-changed("water.until", v); } } }
                }
                if root.page == "water" : Heading { text: "GOAL"; }
                if root.page == "water" : Card {
                    SettingRow { title: "Daily goal"; hint: ""; Stepper { value: root.s.water-goal; minimum: 100; maximum: 10000; step: 50; unit: "ml"; changed(v) => { root.number-changed("water.goal_ml", v); } } }
                    SettingRow { title: "Glass size"; hint: "What one tap on + adds."; last: true; Stepper { value: root.s.water-glass; minimum: 10; maximum: 2000; step: 10; unit: "ml"; changed(v) => { root.number-changed("water.glass_ml", v); } } }
                }

                // ── Focus ──
                if root.page == "focus" : Heading { text: "TIMER"; }
                if root.page == "focus" : Card {
                    SettingRow { title: "Focus"; hint: "Minutes in a round."; Stepper { value: root.s.focus-min; minimum: 1; maximum: 180; unit: "min"; changed(v) => { root.number-changed("focus.focus_min", v); } } }
                    SettingRow { title: "Short break"; hint: ""; Stepper { value: root.s.short-min; minimum: 1; maximum: 60; unit: "min"; changed(v) => { root.number-changed("focus.short_min", v); } } }
                    SettingRow { title: "Long break"; hint: ""; Stepper { value: root.s.long-min; minimum: 1; maximum: 120; unit: "min"; changed(v) => { root.number-changed("focus.long_min", v); } } }
                    SettingRow { title: "Long break every"; hint: "Focus rounds before a long break."; last: true; Stepper { value: root.s.rounds; minimum: 1; maximum: 12; unit: "rounds"; changed(v) => { root.number-changed("focus.rounds", v); } } }
                }

                // ── System ──
                // ── Prayer ──
                if root.page == "prayer" : Heading { text: "PLACE"; }
                if root.page == "prayer" : Card {
                    Rectangle {
                        property <int> per-row: 4;
                        property <length> gap: 8px;
                        property <length> chip-w: (self.width - 32px - (self.per-row - 1) * self.gap) / self.per-row;
                        height: 16px * 2 + ceil(root.s.prayer-places.length / self.per-row) * (28px + self.gap) - self.gap;
                        for name[i] in root.s.prayer-places : SmallButton {
                            x: 16px + mod(i, parent.per-row) * (parent.chip-w + parent.gap);
                            y: 16px + floor(i / parent.per-row) * (28px + parent.gap);
                            width: parent.chip-w;
                            label: name;
                            primary: name == root.s.prayer-place;
                            clicked => { root.place-picked(name); }
                        }
                    }
                }
                if root.page == "prayer" : Heading { text: "REMINDERS"; }
                if root.page == "prayer" : Card {
                    SettingRow { title: "Remind before"; hint: "Minutes before each prayer; 0 for none."; Stepper { value: root.s.prayer-remind; minimum: 0; maximum: 30; unit: "min"; changed(v) => { root.number-changed("prayer.remind_before_min", v); } } }
                    SettingRow { title: "At prayer time"; hint: "Subuh, Dzuhur, Ashar, Maghrib and Isya."; last: true; Toggle { on: root.s.prayer-at-time; toggled(v) => { root.flag-changed("prayer.at_time", v); } } }
                }

                // ── Day Progress ──
                if root.page == "day" : Heading { text: "YOUR DAY"; }
                if root.page == "day" : Card {
                    SettingRow { title: "Wake time"; hint: "Where the day's bar starts."; Stepper { value: root.s.day-wake; minimum: 0; maximum: root.s.day-bedtime - 30; step: 30; time: true; changed(v) => { root.number-changed("day.wake", v); } } }
                    SettingRow { title: "Bedtime"; hint: "Where it ends; the island counts down to it."; last: true; Stepper { value: root.s.day-bedtime; minimum: root.s.day-wake + 30; maximum: 1439; step: 30; time: true; changed(v) => { root.number-changed("day.bedtime", v); } } }
                }

                if root.page == "system" : Heading { text: "NOTICES"; }
                if root.page == "system" : Card {
                    SettingRow { title: "Volume"; hint: ""; glyph: "\u{E767}"; Toggle { on: root.s.sys-volume; toggled(v) => { root.flag-changed("system.volume", v); } } }
                    SettingRow { title: "Caps Lock"; hint: ""; glyph: "\u{E84A}"; Toggle { on: root.s.sys-caps; toggled(v) => { root.flag-changed("system.caps_lock", v); } } }
                    SettingRow { title: "Keyboard layout"; hint: ""; glyph: "\u{E765}"; Toggle { on: root.s.sys-layout; toggled(v) => { root.flag-changed("system.keyboard_layout", v); } } }
                    SettingRow { title: "Charger"; hint: ""; glyph: "\u{E945}"; Toggle { on: root.s.sys-charger; toggled(v) => { root.flag-changed("system.charger", v); } } }
                    SettingRow { title: "Network"; hint: ""; glyph: "\u{E701}"; Toggle { on: root.s.sys-network; toggled(v) => { root.flag-changed("system.network", v); } } }
                    SettingRow { title: "Audio output"; hint: "Headphones connected or gone."; glyph: "\u{E7F6}"; Toggle { on: root.s.sys-audio; toggled(v) => { root.flag-changed("system.audio_device", v); } } }
                    SettingRow { title: "Mic & camera dot"; hint: "Orange while an app uses the microphone, green for the camera."; glyph: "\u{E720}"; last: true; Toggle { on: root.s.sys-mic-cam; toggled(v) => { root.flag-changed("system.mic_cam", v); } } }
                }

                // ── Claude Code ──
                if root.page == "claude" : Heading { text: "CONNECTION"; }
                if root.page == "claude" : Card {
                    SettingRow {
                        title: root.s.claude-installed ? "Connected" : "Not connected";
                        hint: root.s.claude-status;
                        glyph: SetGlyphs.page("claude");
                        glyph-tint: root.s.claude-installed ? #30d158 : K.ink;
                        tall: true;
                        last: true;
                        SmallButton {
                            label: root.s.claude-installed ? "Disconnect…" : "Connect…";
                            primary: !root.s.claude-installed;
                            clicked => { root.claude-connect(!root.s.claude-installed); }
                        }
                    }
                }
                if root.page == "accounts" && root.account-note != "" : Text { text: root.account-note; color: #ff9f0a; font-size: 12.5px; wrap: word-wrap; }
                if root.page == "accounts" : Heading { text: "CLAUDE DESKTOP"; }
                if root.page == "accounts" : AccountsCard {
                    service: "desktop";
                    rows: root.accounts-desktop;
                    add-hint: "Switch to it on the island's Accounts tab, then sign in to Claude.";
                    act(a, id, v) => { root.account-act(a, id, v); }
                }
                if root.page == "accounts" : Heading { text: "CLAUDE CODE"; }
                if root.page == "accounts" : AccountsCard {
                    service: "claude";
                    rows: root.accounts-claude;
                    add-hint: "A terminal opens to sign it in.";
                    act(a, id, v) => { root.account-act(a, id, v); }
                }
                if root.page == "accounts" : Heading { text: "CODEX"; }
                if root.page == "accounts" : AccountsCard {
                    service: "codex";
                    rows: root.accounts-codex;
                    add-hint: "A terminal opens to sign it in.";
                    act(a, id, v) => { root.account-act(a, id, v); }
                }
            }
        }
    }
}

export component Tray inherits SystemTrayIcon {
    icon: @image-url("../assets/tray.png");
    tooltip: "Kanmuri";
    callback open-settings();
    callback quit();
    Menu {
        MenuItem { title: "Settings…"; activated => { root.open-settings(); } }
        MenuSeparator { }
        MenuItem { title: "Quit Kanmuri"; activated => { root.quit(); } }
    }
}

/// A yes/no question before something is written outside Kanmuri.
export component ConfirmWindow inherits Window {
    default-font-family: "Allo";
    title: "Kanmuri";
    preferred-width: 520px;
    // Its wrapped message doesn't size the window: tall enough for it and the buttons.
    preferred-height: 300px;
    min-height: 260px;
    in property <bool> repaint;
    background: root.repaint ? Palette.background : Palette.background.with-alpha(0.999);
    in property <string> heading;
    in property <string> message;
    in property <string> confirm-label: "Confirm";
    callback answered(bool);
    VerticalLayout {
        padding: 18px;
        spacing: 12px;
        Text { text: root.heading; font-size: 15px; font-weight: 700; wrap: word-wrap; }
        Text { text: root.message; font-size: 12.5px; wrap: word-wrap; }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            Button { text: "Cancel"; clicked => { root.answered(false); } }
            Button { text: root.confirm-label; primary: true; clicked => { root.answered(true); } }
        }
    }
}
