    pure public function pick(theme: string, frame: string, left: bool) -> image {
        if (theme == "fubuki") { return left ? self.fubuki_l(frame) : self.fubuki_r(frame); }
        if (theme == "mio") { return left ? self.mio_l(frame) : self.mio_r(frame); }
        if (theme == "towa") { return left ? self.towa_l(frame) : self.towa_r(frame); }
        if (theme == "azki") { return left ? self.azki_l(frame) : self.azki_r(frame); }
        if (theme == "suisei") { return left ? self.suisei_l(frame) : self.suisei_r(frame); }
        return left ? self.fubuki_l(frame) : self.fubuki_r(frame);
    }
